d":{"line":1,"column":1}},"key":"FqAgw1SmcT"}],"identifier":"grid-generation","label":"Grid Generation","html_id":"grid-generation","implicit":true,"key":"BwKOZxt0yQ"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Let’s make a small domain in a northerly area","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"L47OWVi0iw"}],"key":"s0EQ7Me1fM"}],"identifier":"1fad644a","html_id":"1fad644a","key":"hw92fmAjTu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\n\nfrom CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\nfrom CrocoDash.topo import Topo\nfrom CrocoDash.case import Case\n\n\ngrid = Grid.from_projection(\n    crs=\"EPSG:3338\",        # Alaska Albers (std parallels 55N/65N, CM 154W)\n    x_min=-1_000_000,       # meters, Albers origin at (154W, 50N)\n    x_max= 1_200_000,\n    y_min=  400_000,\n    y_max= 1_600_000,\n    resolution_m=10_000,    # 10 km\n    name=\"alaska_10km\",\n)\n\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_from_dataset(    \n    bathymetry_path = \"<GEBCO_LOWRES>\",\n    longitude_coordinate_name=\"lon\",\n    latitude_coordinate_name=\"lat\",\n    vertical_coordinate_name=\"elevation\"\n)\n\ntopo.depth.plot()\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = topo.max_depth,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)\n","key":"EQwXrTx99X"},{"type":"outputs","id":"44GO6Di5Uix4nFwLnxDLj","children":[],"key":"udULWQ6003"}],"identifier":"75c13629","html_id":"75c13629","key":"uP3mn6YTfo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# CESM case (experiment) name\ncasename = \"ks_alaska_10km\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = '<PROJECT>',\n    job_queue = \"<JOB_QUEUE>\", # PBS queue the run is submitted to\n    job_wallclock_time = \"<WALLCLOCK_1H>\", # hh:mm:ss walltime requested for the run\n    override = True,\n    machine = \"derecho\",\n    compset = \"1850_DATM%JRA_SLND_CICE_MOM6%REGIONAL%MARBL-BIO_DROF%GLOFAS_SGLC_WW3\" )\n","key":"NeUQGdKCkB"},{"type":"outputs","id":"pcUpmY2Fp5DET54Ay7XX0","children":[],"key":"lbGthpBIDO"}],"identifier":"b4bf07f1","html_id":"b4bf07f1","key":"kZ8Be4XfPP"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Forcings","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"w9KR5DgrJd"}],"identifier":"forcings","label":"Forcings","html_id":"forcings","implicit":true,"key":"bxYoVsoZTn"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"DROF is the only new component here. All we need to do is provide a mesh file to get the runoff going. All CrocoDash does is generate a mapping file for the runoff data. The CESM coupler actually passes the data in (which we specify through the compset).","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"DqF5QE0ypE"}],"key":"j6YxkclVM1"}],"identifier":"38566b0d","html_id":"38566b0d","key":"KHptkSWeZh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range=[\"2020-01-01 00:00:00\", \"2020-01-09 00:00:00\"],\n    product_name=\"reference_ocean\",\n    function_name=\"get_reference_ocean_data\",\n    marbl_ic_filepath=\"<MARBL_IC>\",\n    restore_ice=True,\n    cice_product_name=\"reference_ice\",\n    cice_function_name=\"get_reference_ice_data\",\n    ww3_obc_product_name=\"reference_waves\",\n    ww3_obc_function_name=\"get_reference_wave_spectra\",\n    rof_esmf_mesh_filepath=\"<GLOFAS_MESH>\",\n)\n","key":"HeERKz15mF"},{"type":"outputs","id":"-KHq4qZsev70DKFvZst8o","children":[],"key":"NcVEHfHp0V"}],"identifier":"93eb1cf6","html_id":"93eb1cf6","key":"lA5JYZsnM1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.process_forcings()\n","key":"ffNWbdhHYq"},{"type":"outputs","id":"xQIEtQGtg53DK46VaOaB-","children":[],"key":"tiUanZRUiJ"}],"identifier":"b1632c46","html_id":"b1632c46","key":"AvhotAbaaM"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s see if this works! If you’re interested in this setup, you can swap in real data for each product as you go along! It’ll take some serious time to run!","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CmrqkEkrGL"}],"key":"SmeVSb6zLw"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"With this many components active, I’d mess with the NTASKS/ROOTPE layout for each one to make sure everything looks reasonable, then a quick build & submit.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"mC5WyeBw0W"}],"key":"YFdNvp9dRS"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Feel free to iterate with process forcings! You can run it on the command line with ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"vHbWtVBTbm"},{"type":"inlineC