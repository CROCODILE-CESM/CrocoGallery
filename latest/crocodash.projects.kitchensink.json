me=\"alaska_10km\",\n)\n\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_from_dataset(    \n    bathymetry_path = \"<GEBCO_LOWRES>\",\n    longitude_coordinate_name=\"lon\",\n    latitude_coordinate_name=\"lat\",\n    vertical_coordinate_name=\"elevation\"\n)\n\ntopo.depth.plot()\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = topo.max_depth,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)\n","key":"Nte3JPS141"},{"type":"outputs","id":"TVhRbu4WHeZFolHqML7My","children":[],"key":"uheCtNbYT6"}],"identifier":"75c13629","html_id":"75c13629","key":"UPEBQwNyZC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# CESM case (experiment) name\ncasename = \"ks_alaska_10km\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = '<PROJECT>',\n    job_queue = \"<JOB_QUEUE>\", # PBS queue the run is submitted to\n    job_wallclock_time = \"<WALLCLOCK_1H>\", # hh:mm:ss walltime requested for the run\n    override = True,\n    machine = \"derecho\",\n    compset = \"1850_DATM%JRA_SLND_CICE_MOM6%REGIONAL%MARBL-BIO_DROF%GLOFAS_SGLC_WW3\" )\n","key":"Ky3Nrx5977"},{"type":"outputs","id":"A7OHoENf-0ocYMm7S9kg_","children":[],"key":"AvZLz4p7yZ"}],"identifier":"b4bf07f1","html_id":"b4bf07f1","key":"B9TVE79XWQ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Forcings","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pVgeTryKo9"}],"identifier":"forcings","label":"Forcings","html_id":"forcings","implicit":true,"key":"RXDcE2qzGG"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"DROF is the only new component here. All we need to do is provide a mesh file to get the runoff going. All CrocoDash does is generate a mapping file for the runoff data. The CESM coupler actually passes the data in (which we specify through the compset).","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"JYjvYtu3px"}],"key":"LPznJOiFKG"}],"identifier":"38566b0d","html_id":"38566b0d","key":"b2bbPbkwn3"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range=[\"2020-01-01 00:00:00\", \"2020-01-09 00:00:00\"],\n    product_name=\"reference_ocean\",\n    function_name=\"get_reference_ocean_data\",\n    marbl_ic_filepath=\"<MARBL_IC>\",\n    restore_ice=True,\n    cice_product_name=\"reference_ice\",\n    cice_function_name=\"get_reference_ice_data\",\n    ww3_obc_product_name=\"reference_waves\",\n    ww3_obc_function_name=\"get_reference_wave_spectra\",\n    rof_esmf_mesh_filepath=\"<GLOFAS_MESH>\",\n)\n","key":"YuXtWCa1UW"},{"type":"outputs","id":"PtxqYn6HAT_vhrwQsjHOU","children":[],"key":"ts8mDqeIgb"}],"identifier":"93eb1cf6","html_id":"93eb1cf6","key":"QRp9Y2uHk9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.process_forcings()\n","key":"hvlPF0035M"},{"type":"outputs","id":"KTxoRrr1XAjzHgzT2BIlD","children":[],"key":"cv6s7rKBtk"}],"identifier":"b1632c46","html_id":"b1632c46","key":"lFsZqrJMqu"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s see if this works! If you’re interested in this setup, you can swa