odile​-cesm​.github​.io​/SeaSloth​/mom6​_scaling​.html","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fKcKhMEdIt"}],"urlSource":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","key":"glIsDi4zuM"}],"key":"ToZHSMeRIW"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Given how fast the scaling 100x100 domain is, I think we should go with that. If we provide ~40 cores for the ocean, it’ll run wicked fast.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"EeEncgFpEs"}],"key":"RNCF8nDmD0"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"We’ll pick a standard vertical grid.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"XJv56a0xwQ"}],"key":"O4v8yNKYpN"}],"key":"GIybUwJcb2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\n\ngrid = Grid(\n  resolution = 0.05, # in degrees\n  xstart = 278.0, # min longitude in [0, 360]\n  lenx = 5.0, # longitude extent in degrees\n  ystart = 7.0, # min latitude in [-90, 90]\n  leny = 5.0, # latitude extent in degrees\n  name = \"basic_grid\",\n)\n\n\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = 2000,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)","key":"rcYpoXy86d"},{"type":"outputs","id":"ntL0MleN2yU1344PPhuZp","children":[],"key":"EBy2uuEpQU"}],"key":"KeaqUysiMA"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now that we have our grids, we need to setup our bathymetry. Normally, we’d use the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eKS6MMSJAu"},{"type":"inlineCode","value":"Topo.set_from_dataset","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lKz3Nm32fX"},{"type":"text","value":" function to go from a bathymetry dataset to grid bathymetry. However, we’re trying to move with purpose, so we can use Topo helper functions to create our own fake fun little domain.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"STHnMnnVXE"}],"key":"GbuCZ3mCkd"}],"key":"BVScA7YIaV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.topo import Topo\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_bowl(max_depth = 2000, dedge = 200)\n\ntopo.depth.plot()","key":"IBkOOzEHlT"},{"type":"outputs","id":"hVnM1v_9WFTH88fJz_6Ie","children":[],"key":"Rav1TyON7u"}],"key":"NsrKvVK6SW"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Great! So I’m going to create my case now, and this step will hardly ever change!","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iKTPdRkNIo"}],"key":"XfMf5WyZ3P"}],"key":"xkI5MS3MDo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nfrom CrocoDash.case import Case\n\n# CESM case (experiment) name\ncasename = \"basic_ocean\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = \"<PROJECT>\", # Update this with your project code\n    override = True,\n    machine = \"derecho\",\n    compset = \"CR_JRA\"\n)","key":"O3jX2ERpL4"},{"type":"outputs","id":"EYQ5aJSRfPziP2_0BMEzt","children":[],"key":"AWiWHyjTwH"}],"key":"zu5LQh2sKJ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now, the last step is to generate forcings, which is done as a two step configure and process. Since it can take a long time to get raw data from outside sources, we’re going to use a fake data generator that comes with CrocoDash.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GK41OhAq3Q"}],"key":"gOaGnMWkUJ"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"I also think we can run for 60 days. That doesn’t sound too bad.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"QXE7YttogU"}],"key":"eweTN2GAJ8"}],"key":"B8A22dlmkR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range = [\"2019-01-01 00:00:00\", \"2019-03-03 00:00:00\"],\n    product_name=\"reference_ocean\",\n    function_name=\"get_reference_ocean_data\"\n)\n","key":"RyyILSa7Bq"},{"type":"outputs","id":"UCo2naejf0wGaeyWub290","children":[],"key":"C1IbAIIV3M"}],"key":"QR6XcHOexC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.process_forcings()\n","key":"pNlP9etChQ"},{"type":"outputs","id":"Du_T7cmNjfU8icaC6DrHp","children":[],"key":"cNocCpmZsX"}],"key":"reZVXFDfje"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Cool! Once this is done, we have to ","position":{"start":{"line":1,"column":1},"end":