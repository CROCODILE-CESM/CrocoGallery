odile​-cesm​.github​.io​/SeaSloth​/mom6​_scaling​.html","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"odvpI48H82"}],"urlSource":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","key":"c3nJmqubxW"}],"key":"DduTKqNBXn"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Given how fast the scaling 100x100 domain is, I think we should go with that. If we provide ~40 cores for the ocean, it’ll run wicked fast.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ADHjAganhK"}],"key":"JlZfI2vjgz"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"We’ll pick a standard vertical grid.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"qdmA5EfqUR"}],"key":"tbc3vXsyVY"}],"key":"kXGRKoaF3K"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\n\ngrid = Grid(\n  resolution = 0.05, # in degrees\n  xstart = 278.0, # min longitude in [0, 360]\n  lenx = 5.0, # longitude extent in degrees\n  ystart = 7.0, # min latitude in [-90, 90]\n  leny = 5.0, # latitude extent in degrees\n  name = \"basic_grid\",\n)\n\n\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = 2000,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)","key":"r5QX4MEJbM"},{"type":"outputs","id":"-grMYUE4my8UVyjoCAVlY","children":[],"key":"xbK3bIipMV"}],"key":"zas0YaXrRT"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now that we have our grids, we need to setup our bathymetry. Normally, we’d use the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GuYYrDFLKW"},{"type":"inlineCode","value":"Topo.set_from_dataset","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"N2sCidMb4S"},{"type":"text","value":" function to go from a bathymetry dataset to grid bathymetry. However, we’re trying to move with purpose, so we can use Topo helper functions to create our own fake fun little domain.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MB6FxnY4ji"}],"key":"F6LYgTuHiw"}],"key":"lhVP9XLzR9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.topo import Topo\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_bowl(max_depth = 2000, dedge = 200)\n\ntopo.depth.plot()","key":"rvdemJ2rOu"},{"type":"outputs","id":"Q5-2Cqyxl0q0Cvoi6maK7","children":[],"key":"nlYB3wv2U8"}],"key":"rQv2ekaHgX"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Great! So I’m going to create my case now, and this step will hardly ever change!","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EY9GrruZif"}],"key":"xs6OtRhUYP"}],"key":"wbbSZrcR6k"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nfrom CrocoDash.case import Case\n\n# CESM case (experiment) name\ncasename = \"basic_ocean\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = \"<PROJECT>\", # Update this with your project code\n    override = True,\n    machine = \"derecho\",\n    compset = \"CR_JRA\"\n)","key":"SmknQXAEJ0"},{"type":"outputs","id":"dfKQl_fWP3Qgetx6Dtsol","children":[],"key":"db7uDDp39I"}],"key":"WA4mDw9pf0"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now, the last step is to generate forcings, which is done as a two step configure and process. Since it can take a long time to get raw data from outside sources, we’re going to use a fake data generator that comes with CrocoDash.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xogzBGxJw3"}],"key":"jbjkJXqoU6"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"I also think we can run for 60 days. That doesn’t sound too bad.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hxKFb26Va4"}],"key":"V7tV0azIbl"}],"key":"HCf3Etflxp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range = [\"2019-01-01 00:00:00\", \"2019-03-03 00:00:00\"],\n    product_name=\"reference_ocean\",\n    function_name=\"get_reference_ocean_data\"\n)\n","key":"dkcmbWZkXk"},{"type":"outputs","id":"Ebvl-JBKzzbnaeOw5pERz","children":[],"key":"abYHJAXpji"}],"key":"lypclTijJH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.process_forcings()\n","key":"gMR70u5gYT"},{"type":"outputs","id":"irLeE6ZWYOWBpsIu4lGbF","children":[],"key":"MFk6zhRJXx"}],"key":"ErcRZWrNI6"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Cool! Once this is done, we have to ","position":{"start":{"line":1,"column":1},"end":