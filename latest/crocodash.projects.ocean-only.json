{"version":3,"kind":"Notebook","sha256":"cecacca82f03c586f2d2224ee489c06550dec49fe6703bb21c95d14ee63d676b","slug":"crocodash.projects.ocean-only","location":"/crocodash/projects/ocean_only.ipynb","dependencies":[],"frontmatter":{"title":"Project: Ocean Only Configuration - The Bare Minimum","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"CrocoDash","language":"python"},"github":"https://github.com/CROCODILE-CESM/CrocoGallery","numbering":{"title":{"offset":2}},"source_url":"https://github.com/CROCODILE-CESM/CrocoGallery/blob/main/crocodash/projects/ocean_only.ipynb","edit_url":"https://github.com/CROCODILE-CESM/CrocoGallery/edit/main/crocodash/projects/ocean_only.ipynb","exports":[{"format":"ipynb","filename":"ocean_only.ipynb","url":"/CrocoGallery/latest/build/ocean_only-c3ef2a08c323fd97c35a78456eb40a7b.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This project is all about how we create the most basic ocean_only domain to shake things out and get spinning as fast as possible. This is one way of testing everything before we get into our research questions.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"IcgN95fmrI"}],"key":"diL8PKqNKk"}],"identifier":"84b4b4ad","html_id":"84b4b4ad","key":"IVDTCThzKj"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Download this project by either:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oxYaQn3XOE"}],"key":"IlImCnZB7J"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Running the CrocoDash CLI command: ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"dgzYLViXuJ"},{"type":"inlineCode","value":"crocodash template --output ocean_only_case.ipynb --machine glade --notebook crocodash.projects.ocean_only","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jB8YEaJ0zA"}],"key":"Gz58E7rYDl"}],"key":"nMORqbd9kL"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Copying the file from your CrocoDash checkout: ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"B9Fd5cWXOT"},{"type":"inlineCode","value":"gallery/crocodash/projects/ocean_only.ipynb","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"sOIcuUzm32"}],"key":"yYu8uxIN4E"}],"key":"Lgnjkiwjj5"}],"key":"cHA5IghxhT"}],"identifier":"d75d080e","html_id":"d75d080e","key":"LagYNvIqWz"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Grid Generation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"b86htLMs7K"}],"identifier":"grid-generation","label":"Grid Generation","html_id":"grid-generation","implicit":true,"key":"QAXEO45aMO"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The first thing we are going to do is think about how to get a domain. Scaling data is available online, but a 100x100 point domain is relatively quick. If we provide ~40 cores for the ocean, it’ll run within a few minutes.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vy6E5yz7u1"}],"key":"FPrqbTZEd9"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"We’ll pick a 100x100 point horizontal grid and a standard vertical grid.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"CwlpJjO3wK"}],"key":"pjIBrmTuS6"}],"identifier":"e0fc8055","html_id":"e0fc8055","key":"HtBa0UZ2SL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\n\ngrid = Grid(\n  resolution = 0.05, # in degrees\n  xstart = 278.0, # min longitude in [0, 360]\n  lenx = 5.0, # longitude extent in degrees\n  ystart = 7.0, # min latitude in [-90, 90]\n  leny = 5.0, # latitude extent in degrees\n  name = \"basic_grid\",\n)\n\n\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = 2000,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)","key":"p0H3OURqYm"},{"type":"outputs","id":"lHNvtH01kGCdTLDRD9k_v","children":[],"key":"JyCwM2PTke"}],"identifier":"0325b73d","html_id":"0325b73d","key":"B8tiUW2YMS"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now that we have our horizontal and vertical grids, we need to setup our bathymetry. Normally, we’d use the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"B5MNfdzRoA"},{"type":"inlineCode","value":"Topo.set_from_dataset","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RFz4ZgBit5"},{"type":"text","value":" function to go from a bathymetry dataset to grid bathymetry. However, as a first step we’ll skip the dataset entirely and use an idealized bathymetry. ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Q1WxzmydCD"},{"type":"inlineCode","value":"Topo","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OJQX4LrW6U"},{"type":"text","value":" provides helpers mirroring MOM6’s built-in TOPO_CONFIG options, such as ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xFx9lZchsc"},{"type":"inlineCode","value":"spoon","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ewEgBgljU2"},{"type":"text","value":", the analytic basin shape used in MOM6’s idealized double gyre case.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"K30u6YVp2D"}],"key":"NcSV09XQCO"}],"identifier":"35338f50","html_id":"35338f50","key":"rsBatJvw19"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.topo import Topo\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_spoon(max_depth = 2000, dedge = 200)\n\ntopo.depth.plot()","key":"JXByrKE0ql"},{"type":"outputs","id":"GO_MjeuGukzkQ482tEo-n","children":[],"key":"EcT2xEC9WF"}],"identifier":"664779d2","html_id":"664779d2","key":"hU3dPjZ7U8"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Great! So I’m going to create my case now, and this step will hardly ever change!","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"farNWibp7l"}],"key":"GO07TFxd0Z"}],"identifier":"4e386f52","html_id":"4e386f52","key":"JRqVKhbKPy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nfrom CrocoDash.case import Case\n\n# CESM case (experiment) name\ncasename = \"basic_ocean\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = \"<PROJECT>\", # Update this with your project code\n    job_queue = \"<JOB_QUEUE>\", # PBS queue the run is submitted to\n    job_wallclock_time = \"<WALLCLOCK_1H>\", # hh:mm:ss walltime requested for the run\n    override = True,\n    machine = \"derecho\",\n    compset = \"CR_JRA\"\n)","key":"fOxgZ7Bk3I"},{"type":"outputs","id":"fXFWNkIcCRdNoF7ovdeje","children":[],"key":"j0BtVUyOzr"}],"identifier":"ca45d4f1","html_id":"ca45d4f1","key":"Y1voILlFxT"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now, the last step is to generate forcings, which is done as a two step configure and process. Since it can take a long time to get raw data from outside sources, we’re going to use a fake data generator that comes with CrocoDash.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"b7k637r6Ko"}],"key":"rwSzVTJO29"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"I also think we can run for 60 days. That doesn’t sound too bad.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"bhYVsXdREI"}],"key":"Vx4up9Np80"}],"identifier":"44b97111","html_id":"44b97111","key":"VaOWoTGqkS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range = [\"2019-01-01 00:00:00\", \"2019-03-03 00:00:00\"],\n    product_name=\"reference_ocean\",\n    function_name=\"get_reference_ocean_data\"\n)\n","key":"TtABwrU9eF"},{"type":"outputs","id":"QaRlR9mX7Q213EPOcpTmd","children":[],"key":"Cn4Wx7tn2Z"}],"identifier":"7ff41626","html_id":"7ff41626","key":"NBBuamu8I0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.process_forcings()\n","key":"Z0RthJLSgW"},{"type":"outputs","id":"_26eiT_685q2M8qtMbRP9","children":[],"key":"Suxh6EtNzk"}],"identifier":"890857d3","html_id":"890857d3","key":"LUDF7V2jE6"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Cool! Once this is done, we have to ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NAxjQ53ufV"},{"type":"inlineCode","value":"./case.build","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YHXW8MWl17"},{"type":"text","value":" and ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LvxjehBQ8H"},{"type":"inlineCode","value":"./case.submit","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yJX90CmZe1"},{"type":"text","value":" in our case directory. Before that though, here’s some things I’d ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"scvVBZdfZ2"},{"type":"inlineCode","value":"xmlchange","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"i7H3lsUU5b"},{"type":"text","value":" to make the domain run faster.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zz8sBEV97j"}],"key":"TKDoAFXZKM"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"WV5NWNHMuZ"},{"type":"inlineCode","value":"NTASKS = 10","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wCQ6gAuefx"},{"type":"text","value":", which sets every component to 10 cores, and makes the data atmosphere regridding very fast. (All components share these 10 cores)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Bu2x0ZRAlp"}],"key":"dukr0M1Ncp"}],"key":"qAIIgpymRM"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"LtBFURDvrF"},{"type":"inlineCode","value":"NTASKS_OCN = 40","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"oucSJtWYXM"},{"type":"text","value":" because of the scaling data we saw: ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"fiAvObxNJT"},{"type":"link","url":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"https://​crocodile​-cesm​.github​.io​/SeaSloth​/mom6​_scaling​.html","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"lqNqxn7NKe"}],"urlSource":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","key":"KLgpohU8XC"}],"key":"sQ6Ek7Cx76"}],"key":"JWINig5Z6h"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"oU0mKBUpgu"},{"type":"inlineCode","value":"ROOTPE = 0","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"mZt0bIQgUQ"},{"type":"text","value":", which ensures that all components share the same cores. If I set ROOTPE_OCN=10, it would skip the first 10 cores and run on the next 40 cores.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"r39wXX8Zcn"}],"key":"GAAOYtUXL7"}],"key":"ekDrb8Gx3G"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"IRZlDdiVxq"},{"type":"inlineCode","value":"JOB_WALLCLOCK_TIME = 00:30:00 --subgroup case.run","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"WP5PX8rOP1"},{"type":"text","value":", which ensures the queue picks up our job realllly fast.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"NG8vixZohh"}],"key":"qBM903zLYy"}],"key":"BL8EYjlQQG"}],"key":"u5YICumb53"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"And there we go! A fake running ocean model! Isn’t that awesome!","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"duZSPdIhyM"}],"key":"FD9E32G0qy"}],"identifier":"6fa10400","html_id":"6fa10400","key":"mFmC4OF13T"}],"key":"e29JTtm8F8"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"CROCODILE 2026 Workshop Projects","short_title":"Projects","url":"/crocodash/projects","group":"Use Cases"},"next":{"title":"Project: CICE Configuration - Ayy, It’s Chilly!","url":"/crocodash/projects/cice","group":"Use Cases"}}},"domain":"http://localhost:3000"}