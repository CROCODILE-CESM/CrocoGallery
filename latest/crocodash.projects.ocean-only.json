odile​-cesm​.github​.io​/SeaSloth​/mom6​_scaling​.html","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"IDLzD04REt"}],"urlSource":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","key":"n63sTSD5GC"}],"key":"pvaAQNmn7f"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Given how fast the scaling 100x100 domain is, I think we should go with that. If we provide ~40 cores for the ocean, it’ll run wicked fast.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"HHt4kW7Nvx"}],"key":"ZF8Rznflb2"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"We’ll pick a standard vertical grid.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"bF5ihZv6Kw"}],"key":"OSynu7aHhT"}],"key":"zMGJ1iL53B"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\n\ngrid = Grid(\n  resolution = 0.05, # in degrees\n  xstart = 278.0, # min longitude in [0, 360]\n  lenx = 5.0, # longitude extent in degrees\n  ystart = 7.0, # min latitude in [-90, 90]\n  leny = 5.0, # latitude extent in degrees\n  name = \"basic_grid\",\n)\n\n\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = 2000,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)","key":"dloNBXVDEQ"},{"type":"outputs","id":"vwLXcwCV9lr8hEgSa0XAw","children":[],"key":"Oxwx8Glx24"}],"key":"zOGg82gfdC"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now that we have our grids, we need to setup our bathymetry. Normally, we’d use the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"whjH92ppdY"},{"type":"inlineCode","value":"Topo.set_from_dataset","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qcpTKqKJVq"},{"type":"text","value":" function to go from a bathymetry dataset to grid bathymetry. However, we’re trying to move with purpose, so we can use Topo helper functions to create our own fake fun little domain.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"F0TUAG8f9K"}],"key":"UtwUOE0VJu"}],"key":"UQ1J54aSqf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.topo import Topo\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_bowl(max_depth = 2000, dedge = 200)\n\ntopo.depth.plot()","key":"oqqaDvdaBs"},{"type":"outputs","id":"llbYySo-xgCqvpc35LpwA","children":[],"key":"t9uuFotFiE"}],"key":"XXozvffVzg"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Great! So I’m going to create my case now, and this step will hardly ever change!","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IxL8VHxUOs"}],"key":"QX9CgJQqRk"}],"key":"b3GBsUN90d"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nfrom CrocoDash.case import Case\n\n# CESM case (experiment) name\ncasename = \"basic_ocean\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = \"<PROJECT>\", # Update this with your project code\n    override = True,\n    machine = \"derecho\",\n    compset = \"CR_JRA\"\n)","key":"xVzJoOYWMi"},{"type":"outputs","id":"cRVbpAZ1UEyynKyxGwNEC","children":[],"key":"lTjSCzCosk"}],"key":"G8gX3rRe60"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now, the last step is to generate forcings, which is done as a two step configure and process. Since it can take a long time to get raw data from outside sources, we’re going to use a fake data generator that comes with CrocoDash.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cO2ISn4bcc"}],"key":"tJnnfsjMyE"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"I also think we can run for 60 days. That doesn’t sound too bad.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"r8wuIPzJqb"}],"key":"hZWIpxkGC1"}],"key":"oMyb12D0dL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range = [\"2019-01-01 00:00:00\", \"2019-03-03 00:00:00\"],\n    product_name=\"reference_ocean\",\n    function_name=\"get_reference_ocean_data\"\n)\n","key":"T9PlMp4XTn"},{"type":"outputs","id":"70WJh98Cz5O3y9c1FJb2K","children":[],"key":"g8eJvqEJ8D"}],"key":"nmEvzZ0mIZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.process_forcings()\n","key":"Mv1D9iAzMc"},{"type":"outputs","id":"xa37hpiHfiXJmc972_pI1","children":[],"key":"jLz5ZtjfE3"}],"key":"Lgth4JdP7I"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Cool! Once this is done, we have to ","position":{"start":{"line":1,"column":1},"end":