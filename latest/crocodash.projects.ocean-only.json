{"version":3,"kind":"Notebook","sha256":"aa52d9f60291a4e7793a4827a95e631a83baee02bef2d68f7ffe32365d8bc9e9","slug":"crocodash.projects.ocean-only","location":"/crocodash/projects/ocean_only.ipynb","dependencies":[],"frontmatter":{"title":"Project: Ocean Only Configuration - The Bare Minimum","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"CrocoDash","language":"python"},"github":"https://github.com/CROCODILE-CESM/CrocoGallery","numbering":{"title":{"offset":2}},"source_url":"https://github.com/CROCODILE-CESM/CrocoGallery/blob/main/crocodash/projects/ocean_only.ipynb","edit_url":"https://github.com/CROCODILE-CESM/CrocoGallery/edit/main/crocodash/projects/ocean_only.ipynb","exports":[{"format":"ipynb","filename":"ocean_only.ipynb","url":"/CrocoGallery/latest/build/ocean_only-33bbbb81a883c8bd734afef03b36a6c2.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This project is all about how we create the most basic ocean_only domain to shake things out, get spinning as fast as possible. Test everything before we get into our research question.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qvSiyeShXn"}],"key":"Ukuc8xYLti"}],"key":"v9fCP9uNf3"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Download this project by either:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"W7FmV5jWB7"}],"key":"lUbxzLOnFt"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Running the CrocoDash CLI command: ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"npC2F5ZIJ6"},{"type":"inlineCode","value":"crocodash template --machine derecho --notebook crocodash.projects.ocean_only","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"pa1WzGyyqz"}],"key":"qiC5s6TH0s"}],"key":"SsNrwnksub"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Copying the file from your CrocoDash checkout: ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"fYDPuonRXB"},{"type":"inlineCode","value":"demos/crocodash/projects/ocean_only","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"GJxG3RP2Es"}],"key":"M6HtETrk2i"}],"key":"stNjGnziCx"}],"key":"cnRsxVV6RT"}],"key":"tDuFfiVtBo"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Grid Generation - The first thing we are going to do is think about how to get a fast domain going, so I might look at some scaling data we’ve put online: ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"v0dnWNd24D"},{"type":"link","url":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"https://​crocodile​-cesm​.github​.io​/SeaSloth​/mom6​_scaling​.html","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KrclV5soRy"}],"urlSource":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","key":"mz2052ge8B"}],"key":"WunQgxYTKS"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Given how fast a 100x100 domain is, I think we should go with that, with maybe 40 cores for the Ocean. That’ll run wicked fast.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"K6oEV9vYJz"}],"key":"gcP5gNetBU"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"We’ll pick an arbitrary vertical grid.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"HhbiGSGd3l"}],"key":"C9WKmG5cDP"}],"key":"MeKjjaYkOc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\n\ngrid = Grid(\n  resolution = 0.05, # in degrees\n  xstart = 278.0, # min longitude in [0, 360]\n  lenx = 5.0, # longitude extent in degrees\n  ystart = 7.0, # min latitude in [-90, 90]\n  leny = 5.0, # latitude extent in degrees\n  name = \"basic_grid\",\n)\n\n\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = 2000,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)","key":"xOxK3Qmw7h"},{"type":"outputs","id":"6fCrGdKABMIFiPkBJWtBI","children":[],"key":"gayRgFiK6u"}],"key":"y1Vd5lHOyV"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now that we have our grids, we need to setup a bathymetry object. Normally, we’d use the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ea9BRresUC"},{"type":"inlineCode","value":"Topo.set_from_dataset","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DYNch4hEPm"},{"type":"text","value":" function to go from “obs” to a bathymetry on our grid. But we’re trying to move with purpose, so we can use some Topo functions to create our own fun little domain.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VFUIE7mQ1l"}],"key":"QqSYz8WSmw"}],"key":"YDWgYZeXbm"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.topo import Topo\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_bowl(max_depth = 2000, dedge = 200)\n\ntopo.depth.plot()","key":"lEbl2HQ5NG"},{"type":"outputs","id":"yk1Sckuu_7RqYbNZrPzdB","children":[],"key":"SPGo1tVJud"}],"key":"kytdC6YPH4"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Great! So I’m going to create my case now, and this step will hardly every change","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"D5rdti0db8"}],"key":"GkGzL3LmID"}],"key":"bYOUVleSKy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nfrom CrocoDash.case import Case\n\n# CESM case (experiment) name\ncasename = \"basic_ocean\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"/glade/work/manishrv/installs/full_regional_cesm\"\n\n# Place where all your input files go \ninputdir = \"/glade/derecho/scratch/manishrv/croc_input\"\n    \n# CESM case directory\ncaseroot = \"/glade/u/home/manishrv/croc_cases\"\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = \"<PROJECT>\", # Update this with your project code\n    override = True,\n    machine = \"derecho\",\n    compset = \"CR_JRA\"\n)","key":"Kn4ScKpiPm"},{"type":"outputs","id":"ICbB1VW_24XQMFlOqpTiZ","children":[],"key":"vekwlysQOq"}],"key":"Bp42NP0i1N"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now, the last step is to generate forcings. Which we do with a configure and process step. It always takes a long time to get raw data from other places, so we’re going to use a fake data product. I also think we can run for 60 days. Doesn’t sound too bad.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cTfgSKPSqz"}],"key":"ZnXxDB07ot"}],"key":"APw58kIYjd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range = [\"2019-01-01 00:00:00\", \"2019-03-03 00:00:00\"],\n    product_name=\"reference_ocean\",\n    function_name=\"get_reference_ocean_data\"\n)\ncase.process_forcings()","key":"Vw1Gi0Xtm7"},{"type":"outputs","id":"5Klhp4WucU-ATzsAU0ZlO","children":[],"key":"g93HMC7oX5"}],"key":"x12MAJgoXt"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Cool! Once this is done we have to ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xtk1AslFw5"},{"type":"inlineCode","value":"case.build","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FLtF5pY5kU"},{"type":"text","value":" and ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zoWhA7WA3y"},{"type":"inlineCode","value":"case.submit","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hGBW69UZ1X"},{"type":"text","value":" in our case directory. Before that though, here’s some things I’d ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XJKasKYniE"},{"type":"inlineCode","value":"xmlchange","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"N9KahMxfKU"},{"type":"text","value":" to run faster.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"v7ruKnZeYS"}],"key":"QyXFGymM8K"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the NTASKS=10, which sets every component to 10 cores, and makes the data atmosphere regridding very fast. (All components share these 10 cores)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"tPtOGp4NH9"}],"key":"xUhwe7W0p5"}],"key":"WH7w7mmu4n"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the NTASKS_OCN=40 because of the scaling data we saw.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"TYb5jK69Zy"}],"key":"dOKPuurmsi"}],"key":"nE5BFhCDiz"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ROOTPE=0, which ensures that all components share the same cores. If I set ROOTPE_OCN=10, it would skip the first 10 cores and run on the next 40 cores.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"TUM3FiGOn9"}],"key":"pcZZEmBrG2"}],"key":"qUJpjxhNrW"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the JOB_WALLCLOCK_TIME=00:30:00 --subgroup ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"SnaRex57l6"},{"type":"link","url":"http://case.run","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"case.run","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"yxQUHIUqwv"}],"urlSource":"http://case.run","key":"aVaQ59iWYP"},{"type":"text","value":", which ensures the queue picks up our job realllly fast.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"O26FCrITXI"}],"key":"oGYbcdg0IB"}],"key":"hBq5uUtZhu"}],"key":"StPAzxL6BN"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"And there we go! A fake running ocean model! Isn’t that awesome!","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"NZ35MVOSGy"}],"key":"QOGr8yGuuI"}],"key":"GywxowINNl"}],"key":"MjIISS32bg"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"CROCODILE 2026 Workshop Projects","short_title":"Projects","url":"/crocodash/projects","group":"Use Cases"},"next":{"title":"Project: CICE Configuration - Ayy, It’s Chilly!","url":"/crocodash/projects/cice","group":"Use Cases"}}},"domain":"http://localhost:3000"}