":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Running the CrocoDash CLI command: ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XOen5c1986"},{"type":"inlineCode","value":"crocodash template --output ocean_only_case.ipynb --machine glade --notebook crocodash.projects.ocean_only","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"q8dEbunjGI"},{"type":"text","value":", then filling in the paths it leaves as placeholders","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Wqj3obC6hZ"}],"key":"J28LQSzEI4"}],"key":"imHSjA5WLO"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Copying the file from your CrocoDash checkout: ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"UAhDY8DcOC"},{"type":"inlineCode","value":"gallery/crocodash/projects/ocean_only.ipynb","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"awiD74gVYw"}],"key":"RSQe8Zayl1"}],"key":"SrRWjdK7DH"}],"key":"cfgKIjK1nW"}],"identifier":"d75d080e","html_id":"d75d080e","key":"s8Majq2GM3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Grid Generation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rDpZPzszBJ"}],"identifier":"grid-generation","label":"Grid Generation","html_id":"grid-generation","implicit":true,"key":"MGso2zoIeI"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The first thing we are going to do is think about how to get a domain. Scaling data is available online, but a 100x100 point domain is relatively quick. If we provide ~40 cores for the ocean, it’ll run within a few minutes.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TzFQDjNEKn"}],"key":"jvlcSjHqZw"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"We’ll pick a 100x100 point horizontal grid and a standard vertical grid.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"yUEIiRJFkm"}],"key":"TFMUUtT9YE"}],"identifier":"e0fc8055","html_id":"e0fc8055","key":"qM8oXhtSkD"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\n\ngrid = Grid(\n  resolution = 0.05, # in degrees\n  xstart = 278.0, # min longitude in [0, 360]\n  lenx = 5.0, # longitude extent in degrees\n  ystart = 7.0, # min latitude in [-90, 90]\n  leny = 5.0, # latitude extent in degrees\n  name = \"basic_grid\",\n)\n\n\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = 2000,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)","key":"TC0FVWove7"},{"type":"outputs","id":"LZiR2hQgqHdYFccuMUeLL","children":[],"key":"jYiimOXdqc"}],"identifier":"0325b73d","html_id":"0325b73d","key":"tl8UVurSbH"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now that we have our horizontal and vertical grids, we need to setup our bathymetry. Normally, we’d use the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pdTFuKyNRR"},{"type":"inlineCode","value":"Topo.set_from_dataset","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NgBu1YHN0w"},{"type":"text","value":" function to go from a bathymetry dataset to grid bathymetry. However, as a first step we’ll skip the dataset entirely and use an idealized bathymetry. ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"e3MBc7We66"},{"type":"inlineCode","value":"Topo","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tg7vXCE350"},{"type":"text","value":" provides helpers mirroring MOM6’s built-in TOPO_CONFIG options, such as ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Lu01hZ9Pw0"},{"type":"inlineCode","value":"spoon","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cipXx9dlPF"},{"type":"text","value":", the analytic basin shape used in MOM6’s idealized double gyre case.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fS65WOJNvO"}],"key":"ACIMeCNAj5"}],"identifier":"35338f50","html_id":"35338f50","key":"inZNYjgtAQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.topo import Topo\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_spoon(max_depth = 2000, dedge = 200)\n\ntopo.depth.plot()","key":"dLFhTHmHb0"},{"type":"outputs","id":"n3Xs2ZdKdnkx2XUU2YtSe","children":[],"key":"pBdZKKSmFf"}],"identifier":"664779d2","html_id":"664779d2","key":"Lzw5pdGl5b"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Great! So I’m going to create my case now, and this step will hardly ever change!","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KJVuGM1tZI"}],"key":"gPRKl5pT1O"}],"identifier":"4e386f52","html_id":"4e386f52","key":"qtt6IFwvkG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nfrom CrocoDash.case import Case\n\n# CESM case (experiment) name\ncasename = \"basic_ocean\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = \"<PROJECT>\", # Update this with your project code\n    job_queue = \"<JOB_QUEUE>\", # PBS queue the run is submitted to\n    job_wallclock_time = \"<WALLCLOCK_1H>\", # hh:mm:ss walltime requested for the run\n    override = True,\n    machine = \"derecho\",\n    compset = \"CR_JRA\"\n)","key":"R3cW3wTNxx"},{"type":"outputs","id":"RIzjM4UekCKt4PHUZ3VYz","children":[],"key":"xydTMQTj20"}],"identifier":"ca45d4f1","html_id":"ca45d4f1","key":"edv7Y2Owam"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now, the last step is to generate forcings, which is done as a two step configure and process. Since it can take a long time to get raw data from outside sources, we’re going to use a fake data generator that comes with CrocoDash.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TyJjoSs2OJ"}],"key":"bLnP37IyGZ"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"I also think we can run for 60 days. That doesn’t sound too bad.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"FyJsHSPq8U"}],"key":"WzmEzkkj79"}],"identifier":"44b97111","html_id":"44b97111","key":"cBGT0KKYTh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range = [\"2019-01-01 00:00:00\", \"2019-03-03 00:00:00\"],\n    product_name=\"reference_ocean\",\n    function_name=\"get_reference_ocean_data\"\n)\n","key":"KGANzl5enh"},{"type":"outputs","id":"dwTI7wEfqmabVi79e0q_K","children":[],"key":"U0A0nnMOR4"}],"identifier":"7ff41626","html_id":"7ff41626","key":"ZDTntbHkuj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.process_forcings()\n","key":"JYMllhFPXu"},{"type":"outputs","id":"esRqadWeYL_WcD7-w6NsA","children":[],"key":"IflBWZbSBr"}],"identifier":"890857d3","html_id":"890857d3","key":"XvN7lqxVSY"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Cool! Once this is done, we have to ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mQMHaUBTp6"},{"type":"inlineCode","value":"./case.build","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sezDZuaGSE"},{"type":"text","value":" and ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rxt9DvdoNe"},{"type":"inlineCode","value":"./case.submit","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sxfNfdQHV3"},{"type":"text","value":" in our case directory. Before that though, here’s some things I’d ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zGkY4psooc"},{"type":"inlineCode","value":"xmlchange","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mVWoK32bgU"},{"type":"text","value":" to make the domain run faster.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cafFeD0BRI"}],"key":"BUaBOLe15t"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PfEG6hpRrV"},{"type":"inlineCode","value":"NTASKS = 10","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"rNKwRRTYzf"},{"type":"text","value":", which sets every component to 10 cores, and makes the data atmosphere regridding very fast. (All components share these 10 cores)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"eP84FVWqrC"}],"key":"BgajoODDjm"}],"key":"qcMRVwUyJr"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"GZB8QGKNa9"},{"type":"inlineCode","value":"NTASKS_OCN = 40","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"RigmJFV93s"},{"type":"text","value":" because of the scaling data we saw: ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"Vvu0ZP4mdg"},{"type":"link","url":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"https://​crocodile​-cesm​.github​.io​/SeaSloth​/mom6​_scaling​.html","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"Mt30kD5Qa3"}],"urlSource":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","key":"KQ2d0KDWLA"}],"key":"k5ksjbfplc"}],"key":"ltEVGWSqut"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"NfTGgYWPgi"},{"type":"inlineCode","value":"ROOTPE = 0","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"v9NCMUT6yS"},{"type":"text","value":", which ensures that all components share the same cores. If I set ROOTPE_OCN=10, it would skip the first 10 cores and run on the next 40 cores.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"tLdBRre4ao"}],"key":"GYQJ7teWsG"}],"key":"q74NA5ErAM"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"zre9orwQ4Q"},{"type":"inlineCode","value":"JOB_WALLCLOCK_TIME = 00:30:00 --subgroup case.run","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"CaUDxQ2hYg"},{"type":"text","value":", which ensures the queue picks up our job realllly fast.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"ZDS0QEpce1"}],"key":"qYbSUs62my"}],"key":"katfvPNoiD"}],"key":"C0HTqOaKNd"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"And there we go! A fake running ocean model! Isn’t that awesome!","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"QF2ehyGbwT"}],"key":"NGHkonkyrY"}],"identifier":"6fa10400","html_id":"6fa10400","key":"UtC9nIkzt5"}],"key":"iO8pWlDNzQ"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"CROCODILE 2026 Workshop Projects","short_title":"Projects","url":"/crocodash/projects","group":"Use Cases"},"next":{"title":"Project: CICE Configuration - Ayy, It’s Chilly!","url":"/crocodash/projects/cice","group":"Use Cases"}}},"domain":"http://localhost:3000"}