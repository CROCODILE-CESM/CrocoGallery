":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Running the CrocoDash CLI command: ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"yuXUiOkaOv"},{"type":"inlineCode","value":"crocodash template --output ocean_only_case.ipynb --machine glade --notebook crocodash.projects.ocean_only","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"iXZS7m3UrM"},{"type":"text","value":", then filling in the paths it leaves as placeholders","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hhdzIC3DiR"}],"key":"B1nqkZURSl"}],"key":"g9ECBdN3hY"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Copying the file from your CrocoDash checkout: ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"mMVp0fgaIA"},{"type":"inlineCode","value":"gallery/crocodash/projects/ocean_only.ipynb","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"J8lveskVX7"}],"key":"yj53GFDJkZ"}],"key":"tXTe2ZUEpc"}],"key":"LWONAqQJPU"}],"identifier":"d75d080e","html_id":"d75d080e","key":"Eb2MLRDu8f"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Grid Generation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Mqq1Sl51k0"}],"identifier":"grid-generation","label":"Grid Generation","html_id":"grid-generation","implicit":true,"key":"ECoShxqzN4"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The first thing we are going to do is think about how to get a domain. Scaling data is available online, but a 100x100 point domain is relatively quick. If we provide ~40 cores for the ocean, it’ll run within a few minutes.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"nScS97ort0"}],"key":"xvNwc3Di94"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"We’ll pick a 100x100 point horizontal grid and a standard vertical grid.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"KDLcLQ6QWT"}],"key":"WcY5g447yq"}],"identifier":"e0fc8055","html_id":"e0fc8055","key":"oSDLJZFjTW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\n\ngrid = Grid(\n  resolution = 0.05, # in degrees\n  xstart = 278.0, # min longitude in [0, 360]\n  lenx = 5.0, # longitude extent in degrees\n  ystart = 7.0, # min latitude in [-90, 90]\n  leny = 5.0, # latitude extent in degrees\n  name = \"basic_grid\",\n)\n\n\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = 2000,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)","key":"ZeLlEM81EI"},{"type":"outputs","id":"M-nGL_Zralir3aDVkp99k","children":[],"key":"Dn0qP6vjSn"}],"identifier":"0325b73d","html_id":"0325b73d","key":"uUrs51KWY8"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now that we have our horizontal and vertical grids, we need to setup our bathymetry. Normally, we’d use the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sGhPdtAa56"},{"type":"inlineCode","value":"Topo.set_from_dataset","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"G5rEgOFbcZ"},{"type":"text","value":" function to go from a bathymetry dataset to grid bathymetry. However, as a first step we’ll skip the dataset entirely and use an idealized bathymetry. ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nydiBJYLic"},{"type":"inlineCode","value":"Topo","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"We6tSV1Ooa"},{"type":"text","value":" provides helpers mirroring MOM6’s built-in TOPO_CONFIG options, such as ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"h9cUyok3Sh"},{"type":"inlineCode","value":"spoon","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qgFiLTwubJ"},{"type":"text","value":", the analytic basin shape used in MOM6’s idealized double gyre case.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mErD85ssI7"}],"key":"qZLVzK1KUN"}],"identifier":"35338f50","html_id":"35338f50","key":"IHwso7ffXh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.topo import Topo\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_spoon(max_depth = 2000, dedge = 200)\n\ntopo.depth.plot()","key":"pvcfkP8Up8"},{"type":"outputs","id":"MAWVtICPWLOTkjMm3kgs6","children":[],"key":"a4TLbONAfP"}],"identifier":"664779d2","html_id":"664779d2","key":"N6MepDaOI6"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Great! So I’m going to create my case now, and this step will hardly ever change!","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bmo1t8sKBv"}],"key":"ZqjGgdoCv4"}],"identifier":"4e386f52","html_id":"4e386f52","key":"OXe2qX4yls"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nfrom CrocoDash.case import Case\n\n# CESM case (experiment) name\ncasename = \"basic_ocean\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = \"<PROJECT>\", # Update this with your project code\n    job_queue = \"<JOB_QUEUE>\", # PBS queue the run is submitted to\n    job_wallclock_time = \"<WALLCLOCK_1H>\", # hh:mm:ss walltime requested for the run\n    override = True,\n    machine = \"derecho\",\n    compset = \"CR_JRA\"\n)","key":"ZcXeXkWFjH"},{"type":"outputs","id":"was-l6kTOORpH9ApMHRYU","children":[],"key":"cHQZl8Ghfr"}],"identifier":"ca45d4f1","html_id":"ca45d4f1","key":"KyMpejfaEn"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now, the last step is to generate forcings, which is done as a two step configure and process. Since it can take a long time to get raw data from outside sources, we’re going to use a fake data generator that comes with CrocoDash.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kVQfhTr4Er"}],"key":"vxl0xitHXM"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"I also think we can run for 60 days. That doesn’t sound too bad.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"nfdcGeErvN"}],"key":"ikhApsN4zl"}],"identifier":"44b97111","html_id":"44b97111","key":"DPcPkdxIVd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range = [\"2019-01-01 00:00:00\", \"2019-03-03 00:00:00\"],\n    product_name=\"reference_ocean\",\n    function_name=\"get_reference_ocean_data\"\n)\n","key":"E02y4AR4Es"},{"type":"outputs","id":"7ZBjMtw9Wy8yu8-TtGDbv","children":[],"key":"oiyWWhERZN"}],"identifier":"7ff41626","html_id":"7ff41626","key":"InK5foYg0J"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.process_forcings()\n","key":"SHlCHQoJN9"},{"type":"outputs","id":"P9tqAJwqgWVvN6itfO1ON","children":[],"key":"Yy7rv306K7"}],"identifier":"890857d3","html_id":"890857d3","key":"XJLf85HGLJ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Cool! Once this is done, we have to ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"J1mvpyn4EW"},{"type":"inlineCode","value":"./case.build","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"epWHTW5m5C"},{"type":"text","value":" and ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VsZKfHMi5W"},{"type":"inlineCode","value":"./case.submit","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Khvhz83wll"},{"type":"text","value":" in our case directory. Before that though, here’s some things I’d ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xWkgcK1Ibt"},{"type":"inlineCode","value":"xmlchange","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"INx7fckGio"},{"type":"text","value":" to make the domain run faster.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FcKqeLze2H"}],"key":"WhIe7zwUrg"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"cjWm3YuLjR"},{"type":"inlineCode","value":"NTASKS = 10","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VbAy2NUtmr"},{"type":"text","value":", which sets every component to 10 cores, and makes the data atmosphere regridding very fast. (All components share these 10 cores)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Lu0JgDAji0"}],"key":"AtvWDJNfMH"}],"key":"CWyK2BrGKh"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"KXYqqZ0hg7"},{"type":"inlineCode","value":"NTASKS_OCN = 40","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"R7x1EjuO8Q"},{"type":"text","value":" because of the scaling data we saw: ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"PW6Wzv43Di"},{"type":"link","url":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"https://​crocodile​-cesm​.github​.io​/SeaSloth​/mom6​_scaling​.html","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"wkQNo1fmfr"}],"urlSource":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","key":"MRKY0rGMnu"}],"key":"XXzS3inQvx"}],"key":"FaqlabAE8o"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"kuwPYezMWC"},{"type":"inlineCode","value":"ROOTPE = 0","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"qLl8FNOXhH"},{"type":"text","value":", which ensures that all components share the same cores. If I set ROOTPE_OCN=10, it would skip the first 10 cores and run on the next 40 cores.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"taq1UF265O"}],"key":"EVojiex46l"}],"key":"YnpyewGvkx"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"KpjNf4YXrT"},{"type":"inlineCode","value":"JOB_WALLCLOCK_TIME = 00:30:00 --subgroup case.run","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"IuTNJ5sRDv"},{"type":"text","value":", which ensures the queue picks up our job realllly fast.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"kbGOx569AQ"}],"key":"Ndh9HJVRNj"}],"key":"bJ1NcGgPzN"}],"key":"CgmBROfBBJ"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"And there we go! A fake running ocean model! Isn’t that awesome!","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"l1zTM6swVZ"}],"key":"G36E0iSFGm"}],"identifier":"6fa10400","html_id":"6fa10400","key":"ValdtFNzZf"}],"key":"ZhM76yDsN1"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"CROCODILE 2026 Workshop Projects","short_title":"Projects","url":"/crocodash/projects","group":"Use Cases"},"next":{"title":"Project: CICE Configuration - Ayy, It’s Chilly!","url":"/crocodash/projects/cice","group":"Use Cases"}}},"domain":"http://localhost:3000"}