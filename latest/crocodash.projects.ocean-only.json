raph","children":[{"type":"text","value":"Running the CrocoDash CLI command: ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"AM2ttDqY6x"},{"type":"inlineCode","value":"crocodash template --machine derecho --notebook crocodash.projects.ocean_only","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fzgHRnIkIU"}],"key":"K3zZBcYSAX"}],"key":"cPfsnHvQOD"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Copying the file from your CrocoDash checkout: ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"eRa3JPpGQS"},{"type":"inlineCode","value":"demos/crocodash/projects/ocean_only","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"ucyfrgfQyj"}],"key":"ECJnuixxOo"}],"key":"WYKmlT8WeC"}],"key":"oMmenBfgIJ"}],"key":"ExvkxPXCwb"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Grid Generation - The first thing we are going to do is think about how to get a fast domain going, so I might look at some scaling data we’ve put online: ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mQCBSXejv2"},{"type":"link","url":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"https://​crocodile​-cesm​.github​.io​/SeaSloth​/mom6​_scaling​.html","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EOek4Jq9Kk"}],"urlSource":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","key":"FutkCzPwIz"}],"key":"BAqPXwCYZD"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Given how fast a 100x100 domain is, I think we should go with that, with maybe 40 cores for the Ocean. That’ll run wicked fast.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"EzudHqLfBf"}],"key":"W6eGyHiBx9"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"We’ll pick an arbitrary vertical grid.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"rKe92sJgCJ"}],"key":"CVoEvtDY5t"}],"key":"kTPsMtce0W"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\n\ngrid = Grid(\n  resolution = 0.05, # in degrees\n  xstart = 278.0, # min longitude in [0, 360]\n  lenx = 5.0, # longitude extent in degrees\n  ystart = 7.0, # min latitude in [-90, 90]\n  leny = 5.0, # latitude extent in degrees\n  name = \"basic_grid\",\n)\n\n\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = 2000,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)","key":"oOdcAtFh5B"},{"type":"outputs","id":"IxTUwQ4kYouVDXtXzRjx_","children":[],"key":"fe1UBRGyoH"}],"key":"SlbdZ3hZiv"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now that we have our grids, we need to setup a bathymetry object. Normally, we’d use the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"J2tyztJv9J"},{"type":"inlineCode","value":"Topo.set_from_dataset","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SM0c4MsZHU"},{"type":"text","value":" function to go from “obs” to a bathymetry on our grid. But we’re trying to move with purpose, so we can use some Topo functions to create our own fun little domain.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ttOXm7anUp"}],"key":"rvNsd3uV2c"}],"key":"zhednQqNLV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.topo import Topo\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_bowl(max_depth = 2000, dedge = 200)\n\ntopo.depth.plot()","key":"nAMam1YeIN"},{"type":"outputs","id":"OT01tqPZdEiAztZg6gBFU","children":[],"key":"rQfVD34vQc"}],"key":"zAy0yEUVxr"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Great! So I’m going to create my case now, and this step will hardly every change","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sjGWZNR1C8"}],"key":"I5WSqn1XU3"}],"key":"DrH8Ha8iGj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nfrom CrocoDash.case import Case\n\n# CESM case (experiment) name\ncasename = \"basic_ocean\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = \"<PROJECT>\", # Update this with your project code\n    override = True,\n    machine = \"derecho\",\n    compset = \"CR_JRA\"\n)","key":"TIl1XSE9RV"},{"type":"outputs","id":"59_C_8Aiw4ahC7zci8X8-","children":[],"key":"AzyyqISVAv"}],"key":"TKfkzq767n"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now, the last step is to generate forcings. Which we do with a configure and process step. It always takes a long time to get raw data from other places, so we’re going to use a fake data product. I also think we can run for 60 days. Doesn’t sound too bad.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eeJ3E3VHJy"}],"key":"HnpFH6NITs"}],"key":"sKyfAAXDnA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range = [\"2019-01-01 00:00:00\", \"2019-03-03 00:00:00\"],\n    product_name=\"reference_ocean\",\n    function_name=\"get_reference_ocean_data\"\n)\n","key":"siUwq1rTUP"},{"type":"outputs","id":"JWpRL3JyVUqbyIWirTzqb","children":[],"key":"hDHD0KFUlW"}],"key":"JJE9BKMnFL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.process_forcings()\n","key":"UiwldLpId7"},{"type":"outputs","id":"G-v_Onw5qGNYN4vvHC4e_","children":[],"key":"BiO80XPRXv"}],"key":"wNqkazBIUO"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Cool! Once this is done we have to ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sQxUN5B1Im"},{"type":"inlineCode","value":"case.build","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Pj2p2lRX8i"},{"type":"text","value":" and ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"D2GleG5FbB"},{"type":"inlineCode","value":"case.submit","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YmkvEnzqot"},{"type":"text","value":" in our case directory. Before that though, here’s some things I’d ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"p4cJZSIHEx"},{"type":"inlineCode","value":"xmlchange","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XSPauHM71a"},{"type":"text","value":" to run faster.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"duywTPmQQu"}],"key":"J0YaHr7eMq"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the NTASKS=10, which sets every component to 10 cores, and makes the data atmosphere regridding very fast. (All components share these 10 cores)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wxVS4a7Q2w"}],"key":"ydqaamYQ2Q"}],"key":"LoivZTb7kb"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the NTASKS_OCN=40 because of the scaling data we saw.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"zlgEd1hdqN"}],"key":"lX4lOYMsN7"}],"key":"Av3zFxh3V7"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ROOTPE=0, which ensures that all components share the same cores. If I set ROOTPE_OCN=10, it would skip the first 10 cores and run on the next 40 cores.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"YI0b1euwXo"}],"key":"Xwskbn0YVW"}],"key":"Z5PWFSJCuI"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the JOB_WALLCLOCK_TIME=00:30:00 --subgroup ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"kNayKkG6YT"},{"type":"link","url":"http://case.run","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"case.run","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"bXFZtCjd6E"}],"urlSource":"http://case.run","key":"W8UMbNEyGp"},{"type":"text","value":", which ensures the queue picks up our job realllly fast.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"jWGT6vBdty"}],"key":"pSjXTUnc9m"}],"key":"iFfPxUhGK3"}],"key":"hh4OOCSmYF"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"And there we go! A fake running ocean model! Isn’t that awesome!","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"WD9Fq3Q9R6"}],"key":"LfKS949Zs3"}],"key":"oS8Qf0u4NX"}],"key":"H4BmRxsbCq"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"CROCODILE 2026 Workshop Projects","short_title":"Projects","url":"/crocodash/projects","group":"Use Cases"},"next":{"title":"Project: CICE Configuration - Ayy, It’s Chilly!","url":"/crocodash/projects/cice","group":"Use Cases"}}},"domain":"http://localhost:3000"}