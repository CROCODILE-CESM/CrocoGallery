}},"children":[{"type":"text","value":"We’ll pick a 100x100 point horizontal grid and a standard vertical grid.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"orPfK81UlL"}],"key":"bDoCHbcRuq"}],"key":"A0Agl2JCfM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\n\ngrid = Grid(\n  resolution = 0.05, # in degrees\n  xstart = 278.0, # min longitude in [0, 360]\n  lenx = 5.0, # longitude extent in degrees\n  ystart = 7.0, # min latitude in [-90, 90]\n  leny = 5.0, # latitude extent in degrees\n  name = \"basic_grid\",\n)\n\n\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = 2000,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)","key":"Hbwe2LIQTj"},{"type":"outputs","id":"zdGb9RHNEz01l-pbTjAtT","children":[],"key":"qjNDvkwfH8"}],"key":"MtnMn0Ohqh"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now that we have our horizontal and vertical grids, we need to setup our bathymetry. Normally, we’d use the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"znZNsNpI05"},{"type":"inlineCode","value":"Topo.set_from_dataset","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dAT2SZDtcs"},{"type":"text","value":" function to go from a bathymetry dataset to grid bathymetry. However, as a first step we’ll skip the dataset entirely and use an idealized bathymetry. ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bWzrJtSeWa"},{"type":"inlineCode","value":"Topo","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"h9Nf3H7zOn"},{"type":"text","value":" provides helpers mirroring MOM6’s built-in TOPO_CONFIG options, such as ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BN3Eebr3fn"},{"type":"inlineCode","value":"spoon","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gjPZN446mD"},{"type":"text","value":", the analytic basin shape used in MOM6’s idealized double gyre case.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UcQ7n6YmJk"}],"key":"wr7vEv3Qcb"}],"key":"R2RPFK40Xt"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.topo import Topo\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_spoon(max_depth = 2000, dedge = 200)\n\ntopo.depth.plot()","key":"DoYGqP536f"},{"type":"outputs","id":"C2CbTA079icW8FEb9nBt4","children":[],"key":"uowBxsPGot"}],"key":"nY9OI6928P"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Great! So I’m going to create my case now, and this step will hardly ever change!","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"keKSrFtxRC"}],"key":"yYLiM5jm2Z"}],"key":"ttSosP8c1X"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nfrom CrocoDash.case import Case\n\n# CESM case (experiment) name\ncasename = \"basic_ocean\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = \"ncgd0011\", # Update this with your project code\n    override = True,\n    machine = \"derecho\",\n    compset = \"CR_JRA\"\n)","key":"lIWfLt5GZq"},{"type":"outputs","id":"dxHrHTCPG0IlBs1X-rz68","children":[],"key":"qH8CH2BBAU"}],"key":"Qd2D2nMHxw"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now, the last step is to generate forcings, which is done as a two step configure and process. Since it can take a long time to get raw data from outside sources, we’re going to use a fake data generator that comes with CrocoDash.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"R0dSTXmROb"}],"key":"J62iN1bqbI"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"I also think we can run for 60 days. That doesn’t sound too bad.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VczBxt3DFg"}],"key":"kE0pC6piem"}],"key":"zatzmGSXiX"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range = [\"2019-01-01 00:00:00\", \"2019-03-03 00:00:00\"],\n    product_name=\"reference_ocean\",\n    function_name=\"get_reference_ocean_data\"\n)\n","key":"TkiQoeNl5r"},{"type":"outputs","id":"Ix-HtM5uv-pJIFGtrxRun","children":[],"key":"wO9arurcnK"}],"key":"JoK1IApWdS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.process_forcings()\n","key":"EwLlhLpv02"},{"type":"outputs","id":"6JNGWgrUp9IeOirHHwQBZ","children":[],"key":"EEfrZ8wnwX"}],"key":"ttGJUdfqKm"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Cool! Once this is done, we have to ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xWDb3MKdD1"},{"type":"inlineCode","value"