":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Running the CrocoDash CLI command: ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qGJKXftQKl"},{"type":"inlineCode","value":"crocodash template --output ocean_only_case.ipynb --machine glade --notebook crocodash.projects.ocean_only","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"WVnu7cEnZr"},{"type":"text","value":", then filling in the paths it leaves as placeholders","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"n5Hduy6wfs"}],"key":"oFpdzR3mBu"}],"key":"mxPLymFnoR"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Copying the file from your CrocoDash checkout: ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"OdKpbk2m2y"},{"type":"inlineCode","value":"gallery/crocodash/projects/ocean_only.ipynb","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"FrB9WiHbin"}],"key":"kWYc6mn4Mf"}],"key":"OkDoOdW5HB"}],"key":"M67FLmYgDa"}],"identifier":"d75d080e","html_id":"d75d080e","key":"W47C8cHT9D"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Grid Generation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nq3YHkbvDa"}],"identifier":"grid-generation","label":"Grid Generation","html_id":"grid-generation","implicit":true,"key":"X8n4irzRYz"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The first thing we are going to do is think about how to get a domain. Scaling data is available online, but a 100x100 point domain is relatively quick. If we provide ~40 cores for the ocean, it’ll run within a few minutes.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Z4TSUCC10r"}],"key":"BfINr39v48"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"We’ll pick a 100x100 point horizontal grid and a standard vertical grid.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"csfzSNAfcg"}],"key":"kO7pNHsNZg"}],"identifier":"e0fc8055","html_id":"e0fc8055","key":"I9uvtYhuPq"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\n\ngrid = Grid(\n  resolution = 0.05, # in degrees\n  xstart = 278.0, # min longitude in [0, 360]\n  lenx = 5.0, # longitude extent in degrees\n  ystart = 7.0, # min latitude in [-90, 90]\n  leny = 5.0, # latitude extent in degrees\n  name = \"basic_grid\",\n)\n\n\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = 2000,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)","key":"WSbFCqRpTn"},{"type":"outputs","id":"cpdZUTmRK5Og_vPcBr0wv","children":[],"key":"Io71D2d4CS"}],"identifier":"0325b73d","html_id":"0325b73d","key":"Pa5Qc7lYh4"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now that we have our horizontal and vertical grids, we need to setup our bathymetry. Normally, we’d use the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IF7luHk5EU"},{"type":"inlineCode","value":"Topo.set_from_dataset","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XNOY155nWW"},{"type":"text","value":" function to go from a bathymetry dataset to grid bathymetry. However, as a first step we’ll skip the dataset entirely and use an idealized bathymetry. ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FK0KfZyDwh"},{"type":"inlineCode","value":"Topo","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"i3ziHgZDwu"},{"type":"text","value":" provides helpers mirroring MOM6’s built-in TOPO_CONFIG options, such as ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jP6GILjowC"},{"type":"inlineCode","value":"spoon","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xY1AEtObAd"},{"type":"text","value":", the analytic basin shape used in MOM6’s idealized double gyre case.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iOLnN0ep2Y"}],"key":"OLphdmIkZN"}],"identifier":"35338f50","html_id":"35338f50","key":"xGtPQnADCV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.topo import Topo\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_spoon(max_depth = 2000, dedge = 200)\n\ntopo.depth.plot()","key":"JR7WXu5YTQ"},{"type":"outputs","id":"mRSp8L9a94qVswbdyflRO","children":[],"key":"ggYZbYeLDM"}],"identifier":"664779d2","html_id":"664779d2","key":"BRzAtslH6p"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Great! So I’m going to create my case now, and this step will hardly ever change!","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"uAC1Hy3Sws"}],"key":"uBnFtltufB"}],"identifier":"4e386f52","html_id":"4e386f52","key":"yadK9vtkmO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nfrom CrocoDash.case import Case\n\n# CESM case (experiment) name\ncasename = \"basic_ocean\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = \"<PROJECT>\", # Update this with your project code\n    job_queue = \"<JOB_QUEUE>\", # PBS queue the run is submitted to\n    job_wallclock_time = \"<WALLCLOCK_1H>\", # hh:mm:ss walltime requested for the run\n    override = True,\n    machine = \"derecho\",\n    compset = \"CR_JRA\"\n)","key":"NgYlB7DiY5"},{"type":"outputs","id":"KHcjsebydmhZhg22E19Gd","children":[],"key":"qCnOU2bjFb"}],"identifier":"ca45d4f1","html_id":"ca45d4f1","key":"pyVzNU5emC"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now, the last step is to generate forcings, which is done as a two step configure and process. Since it can take a long time to get raw data from outside sources, we’re going to use a fake data generator that comes with CrocoDash.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"r1Hiaf8U3K"}],"key":"GU8gabJdaE"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"I also think we can run for 60 days. That doesn’t sound too bad.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"WZXUtap99P"}],"key":"Ntbht91OtL"}],"identifier":"44b97111","html_id":"44b97111","key":"FDy4CDJ2Jp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range = [\"2019-01-01 00:00:00\", \"2019-03-03 00:00:00\"],\n    product_name=\"reference_ocean\",\n    function_name=\"get_reference_ocean_data\"\n)\n","key":"KA45VEWjW6"},{"type":"outputs","id":"ZO6ouzeTpZeSpStxfhrxQ","children":[],"key":"TEzQ2pYMi4"}],"identifier":"7ff41626","html_id":"7ff41626","key":"FtUFnCr7Ft"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.process_forcings()\n","key":"o5oh0pBEuz"},{"type":"outputs","id":"zdRMtJqMthN-G2M1lgVr_","children":[],"key":"Z2H8GARLaa"}],"identifier":"890857d3","html_id":"890857d3","key":"sr1NxRazcM"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Cool! Once this is done, we have to ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QiOiFwiIzH"},{"type":"inlineCode","value":"./case.build","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ocfPsSrk4v"},{"type":"text","value":" and ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RMBmvYeXnf"},{"type":"inlineCode","value":"./case.submit","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ODoJW2TdJU"},{"type":"text","value":" in our case directory. Before that though, here’s some things I’d ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KSiZwp6ieC"},{"type":"inlineCode","value":"xmlchange","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yGTrLvhyL8"},{"type":"text","value":" to make the domain run faster.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BHlztqwFss"}],"key":"IBRBzdhYaR"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fNVeRZ5Jai"},{"type":"inlineCode","value":"NTASKS = 10","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fsj39x69lV"},{"type":"text","value":", which sets every component to 10 cores, and makes the data atmosphere regridding very fast. (All components share these 10 cores)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PXdfxC5QCv"}],"key":"Sw0c90E39K"}],"key":"c602M04kPD"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"kNqIXFcq79"},{"type":"inlineCode","value":"NTASKS_OCN = 40","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"PLMC6cEdJo"},{"type":"text","value":" because of the scaling data we saw: ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"Y5J5UANmi7"},{"type":"link","url":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"https://​crocodile​-cesm​.github​.io​/SeaSloth​/mom6​_scaling​.html","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"NbChvwdvzO"}],"urlSource":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","key":"ib6QyrRLjp"}],"key":"xG46BsC79Z"}],"key":"wfayzCtDMs"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ZhqovRTqqk"},{"type":"inlineCode","value":"ROOTPE = 0","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"zYQctY1hcc"},{"type":"text","value":", which ensures that all components share the same cores. If I set ROOTPE_OCN=10, it would skip the first 10 cores and run on the next 40 cores.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"WYEeBYK1Sa"}],"key":"dcYLqhQp7l"}],"key":"XJ8DeRjdqc"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"BJ0RlHCZkU"},{"type":"inlineCode","value":"JOB_WALLCLOCK_TIME = 00:30:00 --subgroup case.run","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"jD4R9xDiPA"},{"type":"text","value":", which ensures the queue picks up our job realllly fast.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"CyN8dM6MjV"}],"key":"JMiYFTy7oM"}],"key":"LBq5fCX3Fz"}],"key":"hzeknt8XiU"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"And there we go! A fake running ocean model! Isn’t that awesome!","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"IAiVmO80ar"}],"key":"MqPItvVsMI"}],"identifier":"6fa10400","html_id":"6fa10400","key":"w7oRaxkjxO"}],"key":"TDHRvjeP7b"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"CROCODILE 2026 Workshop Projects","short_title":"Projects","url":"/crocodash/projects","group":"Use Cases"},"next":{"title":"Project: CICE Configuration - Ayy, It’s Chilly!","url":"/crocodash/projects/cice","group":"Use Cases"}}},"domain":"http://localhost:3000"}