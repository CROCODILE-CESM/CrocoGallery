odile​-cesm​.github​.io​/SeaSloth​/mom6​_scaling​.html","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"slR9MfGglK"}],"urlSource":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","key":"EF21XHq93O"}],"key":"WIAxeMpSLz"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Given how fast the scaling 100x100 domain is, I think we should go with that. If we provide ~40 cores for the ocean, it’ll run wicked fast.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"mHBPkuXvYK"}],"key":"h7gbhH3rN5"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"We’ll pick a standard vertical grid.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"X7ltmiEZJ5"}],"key":"P7INCGDhu8"}],"key":"DhgFFJfhHn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\n\ngrid = Grid(\n  resolution = 0.05, # in degrees\n  xstart = 278.0, # min longitude in [0, 360]\n  lenx = 5.0, # longitude extent in degrees\n  ystart = 7.0, # min latitude in [-90, 90]\n  leny = 5.0, # latitude extent in degrees\n  name = \"basic_grid\",\n)\n\n\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = 2000,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)","key":"rPy4xip4GM"},{"type":"outputs","id":"iB_c2Orml5CSHaXSOBAn5","children":[],"key":"kU3i7Rd3k1"}],"key":"Eva1O9UnrS"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now that we have our grids, we need to setup our bathymetry. Normally, we’d use the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IkD9XtaeW3"},{"type":"inlineCode","value":"Topo.set_from_dataset","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cbfijfhGPv"},{"type":"text","value":" function to go from a bathymetry dataset to grid bathymetry. However, we’re trying to move with purpose, so we can use Topo helper functions to create our own fake fun little domain.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rMJsoY9Adw"}],"key":"BeHAS63tiC"}],"key":"uyPGUxNZYj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.topo import Topo\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_bowl(max_depth = 2000, dedge = 200)\n\ntopo.depth.plot()","key":"XW4e07RZOD"},{"type":"outputs","id":"vl-foLS4xsi_HGzuzxtf1","children":[],"key":"CdaIHFxr13"}],"key":"lA99DRrfz3"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Great! So I’m going to create my case now, and this step will hardly ever change!","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FzRMf3tELl"}],"key":"xLD3GVzuZQ"}],"key":"L2e4ENeh3n"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nfrom CrocoDash.case import Case\n\n# CESM case (experiment) name\ncasename = \"basic_ocean\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = \"<PROJECT>\", # Update this with your project code\n    override = True,\n    machine = \"derecho\",\n    compset = \"CR_JRA\"\n)","key":"nDUBp2ct1L"},{"type":"outputs","id":"o-zM0H1bH8dBEkSYWKS14","children":[],"key":"UKSeeLUW77"}],"key":"iEE7URFywk"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now, the last step is to generate forcings, which is done as a two step configure and process. Since it can take a long time to get raw data from outside sources, we’re going to use a fake data generator that comes with CrocoDash.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Hx2EGQ8bAb"}],"key":"kYYxzUpDaZ"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"I also think we can run for 60 days. That doesn’t sound too bad.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qYXgsVJlsf"}],"key":"ptipnuiMGk"}],"key":"KjPszmaDv8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range = [\"2019-01-01 00:00:00\", \"2019-03-03 00:00:00\"],\n    product_name=\"reference_ocean\",\n    function_name=\"get_reference_ocean_data\"\n)\n","key":"EPbyvVFyIO"},{"type":"outputs","id":"O03zlk0inD1srvsWMTjjP","children":[],"key":"wFx0bRXQtb"}],"key":"z4eHIRSMiw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.process_forcings()\n","key":"PxvkSlvJpc"},{"type":"outputs","id":"YABooDx4t8TPtYpu0lYko","children":[],"key":"k3DCAOtrJJ"}],"key":"nqjbx1F0fW"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Cool! Once this is done, we have to ","position":{"start":{"line":1,"column":1},"end":