raph","children":[{"type":"text","value":"Running the CrocoDash CLI command: ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"SEVQjWpdYt"},{"type":"inlineCode","value":"crocodash template --machine derecho --notebook crocodash.projects.ocean_only","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"I0dyVi14z2"}],"key":"ZZYq7VrfnL"}],"key":"bwnpGFuakC"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Copying the file from your CrocoDash checkout: ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"TgtJh4Iu0j"},{"type":"inlineCode","value":"demos/crocodash/projects/ocean_only","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"eOIU3WeMg8"}],"key":"vtpAr9Rpus"}],"key":"mp3yFEIOLL"}],"key":"TcEImrgttT"}],"key":"maj1R4se5V"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Grid Generation - The first thing we are going to do is think about how to get a fast domain going, so I might look at some scaling data we’ve put online: ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"b1S1SAmB11"},{"type":"link","url":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"https://​crocodile​-cesm​.github​.io​/SeaSloth​/mom6​_scaling​.html","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xzIFA66rmJ"}],"urlSource":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","key":"sQwLv9781R"}],"key":"B3JXoUL8tq"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Given how fast a 100x100 domain is, I think we should go with that, with maybe 40 cores for the Ocean. That’ll run wicked fast.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"uSkmxeMuLQ"}],"key":"FbDPOSr46b"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"We’ll pick an arbitrary vertical grid.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ghgZgjEST5"}],"key":"k0QKODDAdv"}],"key":"CdoVFVkmgG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\n\ngrid = Grid(\n  resolution = 0.05, # in degrees\n  xstart = 278.0, # min longitude in [0, 360]\n  lenx = 5.0, # longitude extent in degrees\n  ystart = 7.0, # min latitude in [-90, 90]\n  leny = 5.0, # latitude extent in degrees\n  name = \"basic_grid\",\n)\n\n\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = 2000,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)","key":"f1ZAIxkf7d"},{"type":"outputs","id":"gvY-LWa5xVSls7v2-07FP","children":[],"key":"XNqbi7lhD1"}],"key":"w3oVGqWIlj"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now that we have our grids, we need to setup a bathymetry object. Normally, we’d use the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nH4BKrg7DG"},{"type":"inlineCode","value":"Topo.set_from_dataset","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Iw0AaKPYXu"},{"type":"text","value":" function to go from “obs” to a bathymetry on our grid. But we’re trying to move with purpose, so we can use some Topo functions to create our own fun little domain.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NyKKJjSPe2"}],"key":"FfoUmLcejh"}],"key":"PqjmJNE5UK"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.topo import Topo\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_bowl(max_depth = 2000, dedge = 200)\n\ntopo.depth.plot()","key":"Bcsz8HGsaY"},{"type":"outputs","id":"gYzVjC18uA9H9OOfzhWou","children":[],"key":"hhPh7bhyI1"}],"key":"A0u13yJRoC"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Great! So I’m going to create my case now, and this step will hardly every change","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"H8hlnOSLfP"}],"key":"YRuCZJqwk6"}],"key":"tSWUIaA8kR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nfrom CrocoDash.case import Case\n\n# CESM case (experiment) name\ncasename = \"basic_ocean\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = \"<PROJECT>\", # Update this with your project code\n    override = True,\n    machine = \"derecho\",\n    compset = \"CR_JRA\"\n)","key":"k1BZMlbUIj"},{"type":"outputs","id":"UKjx78R_nhJWlh6ESjiqH","children":[],"key":"HBdaRYQ1co"}],"key":"EgpxqPQguR"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now, the last step is to generate forcings. Which we do with a configure and process step. It always takes a long time to get raw data from other places, so we’re going to use a fake data product. I also think we can run for 60 days. Doesn’t sound too bad.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GurVjXY0vs"}],"key":"pidQ83YfPC"}],"key":"FCsrMg8TsE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range = [\"2019-01-01 00:00:00\", \"2019-03-03 00:00:00\"],\n    product_name=\"reference_ocean\",\n    function_name=\"get_reference_ocean_data\"\n)\n","key":"Vq49g4xpFx"},{"type":"outputs","id":"YvUYDoLq67ZTIP9xwQy9Y","children":[],"key":"J4PqbRrTzA"}],"key":"o49RvKfw3P"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.process_forcings()\n","key":"baUEkeXcWk"},{"type":"outputs","id":"7yosDTUCI3yfm3UFYHBvD","children":[],"key":"X4GbHpoJTs"}],"key":"Tz0XDGEfDa"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Cool! Once this is done we have to ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DkiAhGuA8e"},{"type":"inlineCode","value":"case.build","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XHlvmhG4Y9"},{"type":"text","value":" and ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xiUtnwlHJu"},{"type":"inlineCode","value":"case.submit","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TsyKnhETDd"},{"type":"text","value":" in our case directory. Before that though, here’s some things I’d ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FKMIqXZqNe"},{"type":"inlineCode","value":"xmlchange","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QhmlzYUbYZ"},{"type":"text","value":" to run faster.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KLxbXXdJoT"}],"key":"kVwGOVeZxp"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the NTASKS=10, which sets every component to 10 cores, and makes the data atmosphere regridding very fast. (All components share these 10 cores)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"rpaM7tMH1l"}],"key":"n9wJYS4EBV"}],"key":"bnHkHnRv3s"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the NTASKS_OCN=40 because of the scaling data we saw.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"wOXVDU1q5s"}],"key":"AZ3yU6VSZ8"}],"key":"bOLaf60TYs"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ROOTPE=0, which ensures that all components share the same cores. If I set ROOTPE_OCN=10, it would skip the first 10 cores and run on the next 40 cores.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"DuP7QETT6c"}],"key":"qWLUHdU0Xs"}],"key":"HBpTDXs1Xn"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the JOB_WALLCLOCK_TIME=00:30:00 --subgroup ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"o4t1mPJN0f"},{"type":"link","url":"http://case.run","position":{"