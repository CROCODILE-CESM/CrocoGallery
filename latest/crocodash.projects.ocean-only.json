":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Running the CrocoDash CLI command: ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"IhkpwGfhun"},{"type":"inlineCode","value":"crocodash template --output ocean_only_case.ipynb --machine glade --notebook crocodash.projects.ocean_only","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"MKLnewsaAO"},{"type":"text","value":", then filling in ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"IYILIEkeUq"},{"type":"inlineCode","value":"<CESM>","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"x6Kap744wx"},{"type":"text","value":", ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"kxFICN1TkE"},{"type":"inlineCode","value":"<inputdir>","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"s3CnZf7eUa"},{"type":"text","value":" and ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Jq6mWz0J60"},{"type":"inlineCode","value":"<casedir>","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wFv7QN5qTP"}],"key":"QFwA1Xpwrj"}],"key":"V6OLtPlyLR"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Copying the file from your CrocoDash checkout: ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"VGMCDsGTCT"},{"type":"inlineCode","value":"gallery/crocodash/projects/ocean_only.ipynb","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"CNz75q35Yx"}],"key":"sCFL6SzHp9"}],"key":"e8OvBVGdzW"}],"key":"pRQeenyaDR"}],"identifier":"d75d080e","html_id":"d75d080e","key":"aMU9nJSjHh"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Grid Generation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fwakUDkqWv"}],"identifier":"grid-generation","label":"Grid Generation","html_id":"grid-generation","implicit":true,"key":"aHiLNdJwEI"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The first thing we are going to do is think about how to get a domain. Scaling data is available online, but a 100x100 point domain is relatively quick. If we provide ~40 cores for the ocean, it’ll run within a few minutes.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"cEcnjW7ezA"}],"key":"S0Btb13QKi"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"We’ll pick a 100x100 point horizontal grid and a standard vertical grid.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"YbU1CycoZC"}],"key":"IwtryfxBtF"}],"identifier":"e0fc8055","html_id":"e0fc8055","key":"Q4zqL1ICOL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\n\ngrid = Grid(\n  resolution = 0.05, # in degrees\n  xstart = 278.0, # min longitude in [0, 360]\n  lenx = 5.0, # longitude extent in degrees\n  ystart = 7.0, # min latitude in [-90, 90]\n  leny = 5.0, # latitude extent in degrees\n  name = \"basic_grid\",\n)\n\n\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = 2000,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)","key":"d70gtY9CYa"},{"type":"outputs","id":"4KG80no95gimkpQrc8Aev","children":[],"key":"MkvaJjtq3M"}],"identifier":"0325b73d","html_id":"0325b73d","key":"YCSDw6V8F1"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now that we have our horizontal and vertical grids, we need to setup our bathymetry. Normally, we’d use the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"s6eOCmpOmG"},{"type":"inlineCode","value":"Topo.set_from_dataset","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"aUcLKx6W25"},{"type":"text","value":" function to go from a bathymetry dataset to grid bathymetry. However, as a first step we’ll skip the dataset entirely and use an idealized bathymetry. ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"q5KwGe1f9m"},{"type":"inlineCode","value":"Topo","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kuw6dlg6RV"},{"type":"text","value":" provides helpers mirroring MOM6’s built-in TOPO_CONFIG options, such as ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iVQl3kVZay"},{"type":"inlineCode","value":"spoon","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zNtzHBEmFB"},{"type":"text","value":", the analytic basin shape used in MOM6’s idealized double gyre case.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xu6VYS8WUl"}],"key":"JXtVkiZ1uY"}],"identifier":"35338f50","html_id":"35338f50","key":"FCHH1J0kdq"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.topo import Topo\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_spoon(max_depth = 2000, dedge = 200)\n\ntopo.depth.plot()","key":"JKvEPIRC23"},{"type":"outputs","id":"OYccf18tQ4zAldaOp2YKj","children":[],"key":"fz00oGSLoQ"}],"identifier":"664779d2","html_id":"664779d2","key":"ewbQwt7ERu"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Great! So I’m going to create my case now, and this step will hardly ever change!","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tJmDvO8rhp"}],"key":"ganRkNOQHi"}],"identifier":"4e386f52","html_id":"4e386f52","key":"Da8s73iiTT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nfrom CrocoDash.case import Case\n\n# CESM case (experiment) name\ncasename = \"basic_ocean\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = \"<PROJECT>\", # Update this with your project code\n    job_queue = \"<JOB_QUEUE>\", # PBS queue the run is submitted to\n    job_wallclock_time = \"<WALLCLOCK_1H>\", # hh:mm:ss walltime requested for the run\n    override = True,\n    machine = \"derecho\",\n    compset = \"CR_JRA\"\n)","key":"tN89n0sljF"},{"type":"outputs","id":"W2Lrcj5pV84t7ICPZ-1CU","children":[],"key":"KRkUOWefbo"}],"identifier":"ca45d4f1","html_id":"ca45d4f1","key":"hMp4rL2DlQ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now, the last step is to generate forcings, which is done as a two step configure and process. Since it can take a long time to get raw data from outside sources, we’re going to use a fake data generator that comes with CrocoDash.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KSm5Wod9w1"}],"key":"sjR4iBcWjn"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"I also think we can run for 60 days. That doesn’t sound too bad.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xqpKBK9xjn"}],"key":"GiVEntjV0U"}],"identifier":"44b97111","html_id":"44b97111","key":"VaDvn04O9S"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range = [\"2019-01-01 00:00:00\", \"2019-03-03 00:00:00\"],\n    product_name=\"reference_ocean\",\n    function_name=\"get_reference_ocean_data\"\n)\n","key":"SAWw4Qz6IW"},{"type":"outputs","id":"zZpSvZxl8MVLkwslI6Smz","children":[],"key":"kR3Wiw6bwj"}],"identifier":"7ff41626","html_id":"7ff41626","key":"fkYx6Dmhtc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.process_forcings()\n","key":"DcXsxly4ZP"},{"type":"outputs","id":"siJCaBl6juzAW0AyJv1lz","children":[],"key":"dKKXS5gSEG"}],"identifier":"890857d3","html_id":"890857d3","key":"goF63GMTvS"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Cool! Once this is done, we have to ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"J3g9hBcmwq"},{"type":"inlineCode","value":"./case.build","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fEP2TNjEwH"},{"type":"text","value":" and ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Lxc6TCL9uX"},{"type":"inlineCode","value":"./case.submit","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iPrvKBWR6z"},{"type":"text","value":" in our case directory. Before that though, here’s some things I’d ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QA5XVyGrmc"},{"type":"inlineCode","value":"xmlchange","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rIQnfaSAfP"},{"type":"text","value":" to make the domain run faster.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Ra55dO9GWz"}],"key":"vXw6GESqqO"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Lh7OuxSooH"},{"type":"inlineCode","value":"NTASKS = 10","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Jo9cdTBlRN"},{"type":"text","value":", which sets every component to 10 cores, and makes the data atmosphere regridding very fast. (All components share these 10 cores)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"bS8yyXO77k"}],"key":"tcDjejpF9I"}],"key":"YxXnbxw8vM"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"OWGO7QcujU"},{"type":"inlineCode","value":"NTASKS_OCN = 40","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"XkgsRrBbSk"},{"type":"text","value":" because of the scaling data we saw: ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"i6RRlOjcBC"},{"type":"link","url":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"https://​crocodile​-cesm​.github​.io​/SeaSloth​/mom6​_scaling​.html","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"E56MnZzGlA"}],"urlSource":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","key":"jw6SM6Hzb1"}],"key":"sZNgp1FlPP"}],"key":"pOpuNjduQA"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Ko0p9FU8ps"},{"type":"inlineCode","value":"ROOTPE = 0","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ZSWzEHLUaO"},{"type":"text","value":", which ensures that all components share the same cores. If I set ROOTPE_OCN=10, it would skip the first 10 cores and run on the next 40 cores.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"VGkuet7MJS"}],"key":"BEWWsIY2Gh"}],"key":"mW9j4AnU2I"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"y1x5qpfwvp"},{"type":"inlineCode","value":"JOB_WALLCLOCK_TIME = 00:30:00 --subgroup case.run","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"WBLwVR1r07"},{"type":"text","value":", which ensures the queue picks up our job realllly fast.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"wrH8vh5YOX"}],"key":"NDBspxFaNx"}],"key":"eaB1t3ui1q"}],"key":"vXKjFe4xes"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"And there we go! A fake running ocean model! Isn’t that awesome!","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"cIEMkMdRcf"}],"key":"D98qwpXXCR"}],"identifier":"6fa10400","html_id":"6fa10400","key":"mJwQxiJlS5"}],"key":"iIp82EqJQR"},"references":{"cite":{"order":[],"data":