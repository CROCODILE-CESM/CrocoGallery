raph","children":[{"type":"text","value":"Running the CrocoDash CLI command: ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wbFaR8Y6kU"},{"type":"inlineCode","value":"crocodash template --machine derecho --notebook crocodash.projects.ocean_only","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"HJ9GQXsbEc"}],"key":"LIJroM0SLb"}],"key":"l7it5ELMiO"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Copying the file from your CrocoDash checkout: ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"Xc53kDvEfa"},{"type":"inlineCode","value":"demos/crocodash/projects/ocean_only","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"wFU56DOlM4"}],"key":"tvtdMVeTUz"}],"key":"idReMuHXOd"}],"key":"gyh7UkVg82"}],"key":"yLFAS3TScD"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Grid Generation - The first thing we are going to do is think about how to get a fast domain going, so I might look at some scaling data we’ve put online: ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"e8y96VE3CS"},{"type":"link","url":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"https://​crocodile​-cesm​.github​.io​/SeaSloth​/mom6​_scaling​.html","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pWQLLUgyVu"}],"urlSource":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","key":"DFM89T12h9"}],"key":"OTLgxpcLPB"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Given how fast a 100x100 domain is, I think we should go with that, with maybe 40 cores for the Ocean. That’ll run wicked fast.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"oJHKlHuh31"}],"key":"tSIcm7D8hW"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"We’ll pick an arbitrary vertical grid.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ctgOIZQSKr"}],"key":"DwENsfm579"}],"key":"jJUOqi2Ha8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\n\ngrid = Grid(\n  resolution = 0.05, # in degrees\n  xstart = 278.0, # min longitude in [0, 360]\n  lenx = 5.0, # longitude extent in degrees\n  ystart = 7.0, # min latitude in [-90, 90]\n  leny = 5.0, # latitude extent in degrees\n  name = \"basic_grid\",\n)\n\n\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = 2000,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)","key":"Y9j2viGU05"},{"type":"outputs","id":"niMHfrcm2f-mrIgfIey0j","children":[],"key":"v07MXOjfSV"}],"key":"pjwZ88Y9Lr"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now that we have our grids, we need to setup a bathymetry object. Normally, we’d use the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"uOEEOP7hq6"},{"type":"inlineCode","value":"Topo.set_from_dataset","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"G2NvT1Rnui"},{"type":"text","value":" function to go from “obs” to a bathymetry on our grid. But we’re trying to move with purpose, so we can use some Topo functions to create our own fun little domain.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qUndhMqkyJ"}],"key":"cC06e7BMyu"}],"key":"pXG3RahoKK"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.topo import Topo\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_bowl(max_depth = 2000, dedge = 200)\n\ntopo.depth.plot()","key":"y4VIlRTLQM"},{"type":"outputs","id":"GsLoZx0nnGRzFO9ud7-5s","children":[],"key":"AroO44YHo4"}],"key":"SFfSv7tA9p"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Great! So I’m going to create my case now, and this step will hardly every change","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dF4Xf2KWiT"}],"key":"ut9PHVqq8n"}],"key":"KPK3JUs9G1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nfrom CrocoDash.case import Case\n\n# CESM case (experiment) name\ncasename = \"basic_ocean\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = \"<PROJECT>\", # Update this with your project code\n    override = True,\n    machine = \"derecho\",\n    compset = \"CR_JRA\"\n)","key":"sgpQCJ7c2g"},{"type":"outputs","id":"t4QFL59THAxu3SB2yncEx","children":[],"key":"kz2xf7mo2r"}],"key":"WJzpfwXhtM"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now, the last step is to generate forcings. Which we do with a configure and process step. It always takes a long time to get raw data from other places, so we’re going to use a fake data product. I also think we can run for 60 days. Doesn’t sound too bad.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sTK0d5gXWF"}],"key":"legu3prHRt"}],"key":"ixQ9D8krFn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range = [\"2019-01-01 00:00:00\", \"2019-03-03 00:00:00\"],\n    product_name=\"reference_ocean\",\n    function_name=\"get_reference_ocean_data\"\n)\n","key":"XdYzpEbr9i"},{"type":"outputs","id":"qmmtUm5sGgUsPreOM4L6X","children":[],"key":"Hfb0pUebtT"}],"key":"G0flvoF3ab"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.process_forcings()\n","key":"yMri9pKzSw"},{"type":"outputs","id":"qLwEqqONvzTj_Km9u1hi3","children":[],"key":"PAWcbMvfXK"}],"key":"EMnmPLio9x"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Cool! Once this is done we have to ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UBTsab3nML"},{"type":"inlineCode","value":"case.build","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bQkRsUtYr3"},{"type":"text","value":" and ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JqhSUWBaGv"},{"type":"inlineCode","value":"case.submit","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gFdV1KxZsw"},{"type":"text","value":" in our case directory. Before that though, here’s some things I’d ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"juB2uq1kgH"},{"type":"inlineCode","value":"xmlchange","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VsHArfr6Zm"},{"type":"text","value":" to run faster.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xFyq01CyaS"}],"key":"WAyKELm9y7"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the NTASKS=10, which sets every component to 10 cores, and makes the data atmosphere regridding very fast. (All components share these 10 cores)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"DpV2mfMCe2"}],"key":"bEHl4lKzH0"}],"key":"xdfQV20eot"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the NTASKS_OCN=40 because of the scaling data we saw.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"Vxi8zBehx5"}],"key":"PETz2HtGeM"}],"key":"VjtB0cF5fb"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ROOTPE=0, which ensures that all components share the same cores. If I set ROOTPE_OCN=10, it would skip the first 10 cores and run on the next 40 cores.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"alKm2spdxG"}],"key":"QkG7K4C53S"}],"key":"mIVEkx2N0d"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the JOB_WALLCLOCK_TIME=00:30:00 --subgroup ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"uMkzI3tClX"},{"type":"link","url":"http://case.run","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"case.run","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"pbqrrOVOtj"}],"urlSource":"http://case.run","key":"Ecq8CDrFvm"},{"type":"text","value":", which ensures the queue picks up our job realllly fast.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"VwMz1trp1M"}],"key":"ScOkayCApQ"}],"key":"B5p9voz3Tv"}],"key":"lxw7vcrGkk"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"And there we go! A fake running ocean model! Isn’t that awesome!","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"teTL7kkauO"}],"key":"ioQkVzigs3"}],"key":"HOR79O7Dnr"}],"key":"xXsLjk4p53"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"CROCODILE 2026 Workshop Projects","short_title":"Projects","url":"/crocodash/projects","group":"Use Cases"},"next":{"title":"Project: CICE Configuration - Ayy, It’s Chilly!","url":"/crocodash/projects/cice","group":"Use Cases"}}},"domain":"http://localhost:3000"}