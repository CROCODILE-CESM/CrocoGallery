graph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Given how lat/lon changes a lot towards the poles, we’ll use a projected grid. The only nuance is in the forcing, so we’ll rip through the first few steps first.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"oS3Lll9S5K"}],"key":"Fw1wHCrBN2"}],"identifier":"a8aa8f5b","html_id":"a8aa8f5b","key":"mC5pp5AEyw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\n\nfrom CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\nfrom CrocoDash.topo import Topo\nfrom CrocoDash.case import Case\n\n\ngrid = Grid.from_projection(\n    crs=\"EPSG:3995\",\n    x_min=-1_000_000,  # meters from pole\n    x_max= 1_000_000,\n    y_min=-1_000_000,\n    y_max= 1_000_000,\n    resolution_m=50_000,  # 50 km\n    name=\"arctic_50km\",\n)\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_from_dataset(    \n    bathymetry_path = \"<GEBCO_LOWRES>\",\n    longitude_coordinate_name=\"lon\",\n    latitude_coordinate_name=\"lat\",\n    vertical_coordinate_name=\"elevation\"\n)\n\ntopo.depth.plot()\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = topo.max_depth,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)\n","key":"gtzPXAd6Qi"},{"type":"outputs","id":"rjflbj3v290XdZwBOYxIS","children":[],"key":"FRnQ9ILSh8"}],"identifier":"5836c56d","html_id":"5836c56d","key":"yCBjOwbbTS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# CESM case (experiment) name\ncasename = \"arctic_50km\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = '<PROJECT>',\n    job_queue = \"<JOB_QUEUE>\", # PBS queue the run is submitted to\n    job_wallclock_time = \"<WALLCLOCK_1H>\", # hh:mm:ss walltime requested for the run\n    override = True,\n    machine = \"derecho\",\n    compset = \"GR_JRA\" )\n","key":"K9XbiyxXIn"},{"type":"outputs","id":"ue94dDrzTgY_So9mTpeH7","children":[],"key":"aYhHmSImsG"}],"identifier":"721566fe","html_id":"721566fe","key":"WiJYOloQr7"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"How do CICE OBCs work?","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ClndQPACbI"}],"identifier":"how-do-cice-obcs-work","label":"How do CICE OBCs work?","html_id":"how-do-cice-obcs-work","implicit":true,"key":"ACW7woq5Xc"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"CICE OBCs “restore” from a grid that is exactly one additional cell in each direction. CrocoDash generates that halo grid (one T-cell on every side) and fills it from a CICE-shaped source, which CICE then restores toward. The source is a real global CICE restart (","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"VAcUSPDXf4"},{"type":"inlineCode","value":"cice_restart","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"CuBiehwgds"},{"type":"text","value":"), or ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"bebR6EjIrM"},{"type":"inlineCode","value":"reference_ice","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"bxQweHI4bW"},{"type":"text","value":", a synthetic stand-in that needs no files and is handy for checking the wiring.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"WkHOMZyNu0"}],"key":"b9uQfBg2qz"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Restoring is opt-in, and takes all three of ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"Vsl5u57MnS"},{"type":"inlineCode","value":"restore_ice=True","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"opRn3kP15x"},{"type":"text","value":", ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"N75mkiA6II"},{"type":"inlineCode","value":"cice_product_name","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"DNvGhOYmBQ"},{"type":"text","value":" and ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"PIviWZnhRs"},{"type":"inlineCode","value":"cice_function_name","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"zRwH7j5kT9"},{"type":"text","value":". Leave all three out and CICE runs with zero-gradient boundaries and no restoring. In the following cell, we point the ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"akbaK3mEeH"},{"type":"inlineCode","value":"cice_restart","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"VNyEi8qeqd"},{"type":"text","value":" product at exactly one restart.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"LSAYeqghN0"}],"key":"bIDcycmYBh"}],"identifier":"91ffaa47","html_id":"91ffaa47","key":"W56Z869LtJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range=[\"2020-01-01 00:00:00\", \"2020-01-09 00:00:00\"],\n    function_name=\"get_glorys_data_from_rda\",\n    restore_ice=True,                             # turn on CICE boundary restoring\n    cice_product_name=\"cice_restart\",\n    cice_function_name=\"get_cice_restart_subset\",\n    cice_function_args={\n        \"restart_path\": \"<CICE_RESTART>\",\n        \"grid_path\": \"<TX2_3V3_GRID>\",  # the restart's companion grid file\n    },\n)\n","key":"bN7AXhkNgz"},{"type":"outputs","id":"ZTJW9DJpQqULJ0nI5p-_J","children":[],"key":"Nirr1UYnHB"}],"identifier":"7ce8b5e0","html_id":"7ce8b5e0","key":"BT70o7ECxn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.process_forcings()\n","key":"NqOkdXnEIN"},{"type":"outputs","id":"2HYVGy7q-QroyS5oH10-T","children":[],"key":"AJ8S5T5NCU"}],"identifier":"a8292319","html_id":"a8292319","key":"TQyhKXNKfM"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This restoring we are setting up here is only for boundary conditions. If you want to start from an initial condition, check out the docs here: ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SThjT7ZZxQ"},{"type":"link","url":"https://crocodile-cesm.github.io/CrocoGallery/latest/crocodash/case-setup/#optional-warm-start-from-cice-restart-files","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"https://​crocodile​-cesm​.github​.io​/CrocoGallery​/latest​/crocodash​/case​-setup​/​#optional​-warm​-start​-from​-cice​-restart​-files","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Woc4iAzrf7"}],"urlSource":"https://crocodile-cesm.github.io/CrocoGallery/latest/crocodash/case-setup/#optional-warm-start-from-cice-restart-files","key":"pSGXYwEqev"}],"key":"wK6kp93gTp"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"I’d then mess with the NTASKS/ROOTPE layout to make sure everything looks reasonable, then build & submit.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GZv31kY7Pp"}],"key":"v03w0NLLTV"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Feel free to iterate with process forcings! You can run it on the command line with ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"v9Qi5DhIVw"},{"type":"inlineCode","value":"crocodash process --caseroot YOURCASEROOT --all","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"IbCk3yyuKq"},{"type":"text","value":" (or name just the pieces you changed, e.g. ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"vNd7LQCYXe"},{"type":"inlineCode","value":"--bc","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Dkvl0IiNd1"},{"type":"text","value":", ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"JzcMZuiJTc"},{"type":"inlineCode","value":"--cice","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"W47wnQQIDs"},{"type":"text","value":"; see ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ADE0mKyU45"},{"type":"inlineCode","value":"crocodash process -h","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ovFT9ouNdk"},{"type":"text","value":")!","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"d4umOdaEia"}],"key":"jDz2OW5KAp"}],"identifier":"cabe7467","html_id":"cabe7467","key":"z1FzussHcJ"}],"key":"h42oLKOStt"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Project: Ocean Only Configuration - The Bare Minimum","url":"/crocodash/projects/ocean-only","group":"Use Cases"},"next":{"title":"Project: WW3 Configuration - Ayy, It’s Wave!","url":"/crocodash/projects/ww3","group":"Use Cases"}}},"domain":"http://pre.render"}