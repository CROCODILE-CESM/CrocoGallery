{"version":3,"kind":"Notebook","sha256":"69df3c35ca158cb99c8303d2f16f73f294ac95acdbca319d5aaedd10b28d20d6","slug":"crocodash.projects.marbl","location":"/crocodash/projects/marbl.ipynb","dependencies":[],"frontmatter":{"title":"Project: MARBL Configuration - Plankton Time!","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"CrocoDash","language":"python"},"github":"https://github.com/CROCODILE-CESM/CrocoGallery","numbering":{"title":{"offset":2}},"source_url":"https://github.com/CROCODILE-CESM/CrocoGallery/blob/main/crocodash/projects/marbl.ipynb","edit_url":"https://github.com/CROCODILE-CESM/CrocoGallery/edit/main/crocodash/projects/marbl.ipynb","exports":[{"format":"ipynb","filename":"marbl.ipynb","url":"/CrocoGallery/latest/build/marbl-7083f85de0cd5d9d3b527f8408f452df.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This project is about setting up a MARBL configuration and any nuances we might want to consider.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GyFAIoFVID"}],"key":"rWH6xgPbW7"}],"key":"czaoPjAvME"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Download this project by either:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"E8Y9HZ6gZM"}],"key":"itIpTq7rzK"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Running the CrocoDash CLI command: ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xTYTDaDrYf"},{"type":"inlineCode","value":"crocodash template --machine derecho --notebook crocodash.projects.marbl","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"KMtybSdGXp"}],"key":"ccMA7VUlcl"}],"key":"lyjLbCr97v"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Copying the file from your CrocoDash checkout: ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"ufIoX8Q3Zn"},{"type":"inlineCode","value":"demos/crocodash/projects/marbl.ipynb","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"ErBp55Up2J"}],"key":"dHe3SZMJJV"}],"key":"EiNf4m9n1U"}],"key":"FEaZAtjLfM"}],"key":"FABkLYNLME"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Grid Generation - MARBL is integrated into MOM6, so it’s pretty straighforward to setup, there’s not many nuances. Because there are so many tracers, we currently only support using forcing from old CESM runs, which do give data globally.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PhUhg3uXgK"}],"key":"cbrheuc4YG"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"So since MARBL adds cost, we will pick a small domain and run anywhere in the world. Let’s rip through the steps!","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ZQ2MwFxD9T"}],"key":"dHFweQ8t4f"}],"key":"gZK5APgfHe"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\n\nfrom CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\nfrom CrocoDash.topo import Topo\nfrom CrocoDash.case import Case\n\n\ngrid = Grid(\n  resolution = 0.05, # in degrees\n  xstart = 278.0, # min longitude in [0, 360]\n  lenx = 5.0, # longitude extent in degrees\n  ystart = 7.0, # min latitude in [-90, 90]\n  leny = 5.0, # latitude extent in degrees\n  name = \"clear_marbl\",\n)\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_from_dataset(    \n    bathymetry_path = \"<GEBCO_LOWRES>\",\n    longitude_coordinate_name=\"lon\",\n    latitude_coordinate_name=\"lat\",\n    vertical_coordinate_name=\"elevation\"\n)\n\ntopo.depth.plot()\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = topo.max_depth,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)\n","key":"ArdgB5Pux1"},{"type":"outputs","id":"Fo7w7vkZbTroJl-gy78md","children":[],"key":"GnVkFlViD9"}],"key":"w4xnSzDGD1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# CESM case (experiment) name\ncasename = \"lost_my_marbles\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = '<PROJECT>',\n    override = True,\n    machine = \"derecho\",\n    compset = \"CR1850MARBL_JRA\" )\n","key":"ppsw6b8c1C"},{"type":"outputs","id":"b-EDXaKgMUODT3kwFY7Mf","children":[],"key":"PbRfbAWSR0"}],"key":"jeGrJA07uq"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"MARBL Forcing","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"owoQBJ3bJW"}],"identifier":"marbl-forcing","label":"MARBL Forcing","html_id":"marbl-forcing","implicit":true,"key":"SCHmiDt6sS"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We use a global MARBL file to setup the initial condition (It is regridded as part of the model run), and generate OBCs in the same exact way as the MOM6 obc (so we’re just adding >40 more tracers) We need to provide the path to a MARBL run or have it default to a run. What we’re going to use here defaults to a FIESTY run (","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"tTY10SnzMp"},{"type":"link","url":"https://www.sciencedirect.com/science/article/abs/pii/S0079661124001204","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"https://​www​.sciencedirect​.com​/science​/article​/abs​/pii​/S0079661124001204","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"kRlI4TX0yp"}],"urlSource":"https://www.sciencedirect.com/science/article/abs/pii/S0079661124001204","key":"sLQV49Ojuz"},{"type":"text","value":"). We do not support having seperate physical vs MARBL forcings. All the forcings come from one product, in this case CESM POP Output, the old ocean model.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"t7PrUEgmLK"}],"key":"sIoWMutQvB"}],"key":"GysQktI7aN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range=[\"2000-01-01 00:00:00\", \"2000-02-01 00:00:00\"],\n    product_name=\"CESM_POP_OUTPUT\",\n    function_name=\"get_cesm_single_variable_data\",\n    marbl_ic_filepath=\"/glade/campaign/collections/gdex/data/d651077/cesmdata/inputdata/ocn/mom/tx0.66v1/ecosys_jan_IC_omip_latlon_1x1_180W_c231221.nc\",   \n)\n","key":"E0ZKqMkn6l"},{"type":"outputs","id":"SchR9SLBxchBKqeiPmDpG","children":[],"key":"fuUkotaxrf"}],"key":"FqqSsaEfHu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.process_forcings()\n","key":"J02YhZUwMf"},{"type":"outputs","id":"0AIUngOc4y_VvEGncyC6m","children":[],"key":"m1oWCMxW72"}],"key":"NrU1hgcJBd"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"I’d mess with the NTASKS/ROOTPE’s (give more ocean PEs) and build & submit!","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Pw7BoXjvEV"}],"key":"qrG2wO1Ubb"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Feel free to iterate with process forcings! You can run it on the command line with ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vcYyQskQZG"},{"type":"inlineCode","value":"crocodash process --caseroot YOURCASEROOT","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"lv63ZoJ7Fz"},{"type":"text","value":"!","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"CsHt8VlNVQ"}],"key":"t7dSnoZjqk"}],"key":"LdA9vL859G"}],"key":"wowNGFg8dA"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Project: WW3 Configuration - Ayy, It’s Wave!","url":"/crocodash/projects/ww3","group":"Use Cases"},"next":{"title":"Kitchen Sink - Oh My! It’s Everything!","url":"/crocodash/projects/kitchensink","group":"Use Cases"}}},"domain":"http://localhost:3000"}