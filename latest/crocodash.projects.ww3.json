"column":1}},"key":"a1cyX2nfwM"}],"key":"ijHgwrP4Lk"}],"key":"qEBdEkUQPU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\n\nfrom CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\nfrom CrocoDash.topo import Topo\nfrom CrocoDash.case import Case\n\n\ngrid = Grid(\n  resolution = 0.05, # in degrees\n  xstart = 278.0, # min longitude in [0, 360]\n  lenx = 5.0, # longitude extent in degrees\n  ystart = 7.0, # min latitude in [-90, 90]\n  leny = 5.0, # latitude extent in degrees\n  name = \"wave_fun_grid\",\n)\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_from_dataset(    \n    bathymetry_path = \"<GEBCO_LOWRES>\",\n    longitude_coordinate_name=\"lon\",\n    latitude_coordinate_name=\"lat\",\n    vertical_coordinate_name=\"elevation\"\n)\n\ntopo.depth.plot()\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = topo.max_depth,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)\n","key":"zq8xlOq0KK"},{"type":"outputs","id":"JUzAlW0n1BOLI4UaGC4O_","children":[],"key":"se17zlYRjP"}],"key":"xU7ut6fWd8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# CESM case (experiment) name\ncasename = \"wave_fun_zone\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = '<PROJECT>',\n    override = True,\n    machine = \"derecho\",\n    compset = \"1850_DATM%NYF_SLND_SICE_MOM6%REGIONAL_SROF_SGLC_WW3\" )\n","key":"ABrPhKZlnH"},{"type":"outputs","id":"xBiGRp4-gU22xhFWI-9zi","children":[],"key":"iGBbIi82SA"}],"key":"bzowPD8neU"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"WW3 Forcing","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"j9Ljbki5b7"}],"identifier":"ww3-forcing","label":"WW3 Forcing","html_id":"ww3-forcing","implicit":true,"key":"G44PxCtoKP"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"WW3 OBC Forcing also gets set up in a unique way. WW3 comes with a Fortran script to process “station-like” OBCs, and regrids the station data onto the WW3 grid. So all we do is prep “station-like” data. We take a slice of whatever data product we have (which in our case is ERA5 2D Wave Spectra), split the grid points into single point station files, create a file to list them (spec.list), set a few configuration parameters in a different file (bounc.nml) and place them in the input directory for waves (which is defined as a CESM xml variable). When you run ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"oDs0spDJle"},{"type":"inlineCode","value":"./preview_namelist","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xfJ9SOTldB"},{"type":"text","value":" after ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"n2gm1yLiFg"},{"type":"inlineCode","value":"./case.build","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"eVzUocisBE"},{"type":"text","value":", the WW3 part of the preview finds these boundary files and the compiled Fortran scripts and regrids them to your domain into a file called ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ufzfsryY8N"},{"type":"inlineCode","value":"nest.ww3","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Dj9bnfHsnX"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JdA0EgC5Xx"}],"key":"GKtJxUAzak"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"ERA5 2d Wave Spectra is a ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"O8rlzHN7Pi"},{"type":"strong","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"slow access product","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"wZuGBAamRy"}],"key":"fYasaVP44J"},{"type":"text","value":", and requesting data can take ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"SXQUsh3dhh"},{"type":"strong","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"days","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Wdx0DyE86A"}],"key":"NhOW3s675t"},{"type":"text","value":" to get processed. ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Tiv3jL6tbV"},{"type":"strong","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"If you are interested in using ERA5 2d Wave Spectra, request it EARLY in the hacking part of this workshop","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"aeXvs92OV7"}],"key":"QmxTWQn8pM"},{"type":"text","value":". You can request ERA5 2d Wave Spectra by running ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"pD5M4sczq7"},{"type":"inlineCode","value":"case.configure_forcings()","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"TEO0sAdBIl"},{"type":"text","value":" and ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ygYrH7bCmd"},{"type":"inlineCode","value":"case.process_forcings()","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"giZjBbnUEx"},{"type":"text","value":" with the ERA5 2D Wave Spectra product (ERA5_WAVE_SPECTRA) and function name (get_era5_2d_spectra). You will need a login.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"InsmEZmXO8"}],"key":"ydSUJkJNpU"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Because ERA5 2D Wave Spectra is slow, we can use a fake data product to sketch our our domain and make sure everything works first!","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"u8k02rBCuc"}],"key":"EnjNH95Nhu"}],"key":"SxCMZkdgoa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range=[\"2020-01-01 00:00:00\", \"2020-01-09 00:00:00\"],\n    function_name=\"get_glorys_data_from_rda\",\n    ww3_obc_product_name=\"reference_waves\",              \n    ww3_obc_function_name=\"get_reference_wave_spectra\",           \n)\n","key":"mVcIl9OCIK"},{"type":"outputs","id":"AvadrZ9wjmRE55prqkli6","children":[],"key":"F2iKwkHZvH"}],"key":"OubUfev2FN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.process_forcings()\n","key":"OQRyq0SOa4"},{"type":"outputs","id":"O7H6yihs-9qcaMfruQUB8","children":[],"key":"QrPLRmN7cH"}],"key":"lap7yjUODB"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"A quick reminder that we are not creating a WW3 initial condition, so run your domain for a month or two!","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SXYvYE8UYR"}],"key":"dNbloyi851"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":