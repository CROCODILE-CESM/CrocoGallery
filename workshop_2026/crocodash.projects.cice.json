"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Given how lat/lon changes a lot towards the poles, we’ll use a projected grid. The only nuance is in the forcing, so we’ll rip through the first few steps first.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"N674WnLoHg"}],"key":"kEeVP5BfBX"}],"identifier":"a8aa8f5b","html_id":"a8aa8f5b","key":"VI9srkkMdu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\n\nfrom CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\nfrom CrocoDash.topo import Topo\nfrom CrocoDash.case import Case\n\n\ngrid = Grid.from_projection(\n    crs=\"EPSG:3995\",\n    x_min=-1_000_000,  # meters from pole\n    x_max= 1_000_000,\n    y_min=-1_000_000,\n    y_max= 1_000_000,\n    resolution_m=50_000,  # 50 km\n    name=\"arctic_50km\",\n)\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_from_dataset(    \n    bathymetry_path = \"<GEBCO_LOWRES>\",\n    longitude_coordinate_name=\"lon\",\n    latitude_coordinate_name=\"lat\",\n    vertical_coordinate_name=\"elevation\"\n)\n\ntopo.depth.plot()\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = topo.max_depth,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)\n","key":"kDWVlRjqwn"},{"type":"outputs","id":"Yd-KuxE3LWBHZgow1HB5y","children":[],"key":"deuanE0rie"}],"identifier":"5836c56d","html_id":"5836c56d","key":"ul2p9DlI1A"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# CESM case (experiment) name\ncasename = \"arctic_50km\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = '<PROJECT>',\n    job_queue = \"<JOB_QUEUE>\", # PBS queue the run is submitted to\n    job_wallclock_time = \"<WALLCLOCK_1H>\", # hh:mm:ss walltime requested for the run\n    override = True,\n    machine = \"derecho\",\n    compset = \"GR_JRA\" )\n","key":"LOveMMl1ub"},{"type":"outputs","id":"ZNR8nl0fJx784k_7dLuAQ","children":[],"key":"NKUrngbLxa"}],"identifier":"721566fe","html_id":"721566fe","key":"VwPUBuE0ti"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"How do CICE OBCs work?","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lsKFUYCraK"}],"identifier":"how-do-cice-obcs-work","label":"How do CICE OBCs work?","html_id":"how-do-cice-obcs-work","implicit":true,"key":"msR5CTtcEX"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"CICE OBCs “restore” from a grid that is exactly one additional cell in each direction. CrocoDash generates that halo grid (one T-cell on every side) and fills it from a CICE-shaped source, which CICE then restores toward. The source is a real global CICE restart (","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"nEaa2YfFdv"},{"type":"inlineCode","value":"cice_restart","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"M7pWhndQP6"},{"type":"text","value":"), or ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"b89KnOXJnz"},{"type":"inlineCode","value":"reference_ice","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"Vz2Jkp4VpT"},{"type":"text","value":", a synthetic stand-in that needs no files and is handy for checking the wiring.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"IEIWBV6i8R"}],"key":"yTYx5cOMT0"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Restoring is opt-in, and takes all three of ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"FhxQ0QjelU"},{"type":"inlineCode","value":"restore_ice=True","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"CIfHyOA3i7"},{"type":"text","value":", ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"IvmXXYZspa"},{"type":"inlineCode","value":"cice_product_name","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"ZStgkdIaac"},{"type":"text","value":" and ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"LT3ERozeQY"},{"type":"inlineCode","value":"cice_function_name","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"UXl1gQqkzt"},{"type":"text","value":". Leave all three out and CICE runs with zero-gradient boundaries and no restoring. In the following cell, we point the ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"VOdYy2a7OE"},{"type":"inlineCode","value":"cice_restart","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"o74OoOoz95"},{"type":"text","value":" product at exactly one restart.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"trxblBIJLU"}],"key":"nkbUgh8pls"}],"identifier":"91ffaa47","html_id":"91ffaa47","key":"fMohW0930F"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range=[\"2020-01-01 00:00:00\", \"2020-01-09 00:00:00\"],\n    function_name=\"get_glorys_data_from_rda\",\n    restore_ice=True,                             # turn on CICE boundary restoring\n    cice_product_name=\"cice_restart\",\n    cice_function_name=\"get_cice_restart_subset\",\n    cice_function_args={\n        \"restart_path\": \"<CICE_RESTART>\",\n        \"grid_path\": \"<TX2_3V3_GRID>\",  # the restart's companion grid file\n    },\n)\n","key":"NSrMO8QS4Z"},{"type":"outputs","id":"yY99pfG6VX2iNDtNvvMHI","children":[],"key":"Tx1F8QM2h2"}],"identifier":"7ce8b5e0","html_id":"7ce8b5e0","key":"VBcit9ePfb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.process_forcings()\n","key":"oabkCDX90r"},{"type":"outputs","id":"9hedBNBZktKV7FSl45I17","children":[],"key":"QUGbJ3WXqB"}],"identifier":"a8292319","html_id":"a8292319","key":"bgZai81NVU"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This restoring we are setting up here is only for boundary conditions. If you want to start from an initial condition, check out the docs here: ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ib1uspeGd5"},{"type":"link","url":"https://crocodile-cesm.github.io/CrocoGallery/latest/crocodash/case-setup/#optional-warm-start-from-cice-restart-files","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"https://​crocodile​-cesm​.github​.io​/CrocoGallery​/latest​/crocodash​/case​-setup​/​#optional​-warm​-start​-from​-cice​-restart​-files","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"F3PdHoHPL0"}],"urlSource":"https://crocodile-cesm.github.io/CrocoGallery/latest/crocodash/case-setup/#optional-warm-start-from-cice-restart-files","key":"S6wnYpiSfC"}],"key":"euSopB5ttO"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"I’d then mess with the NTASKS/ROOTPE layout to make sure everything looks reasonable, then build & submit.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XN720gEYgz"}],"key":"g6vT8OxgeM"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Feel free to iterate with process forcings! You can run it on the command line with ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"cJ1IiNSFnE"},{"type":"inlineCode","value":"crocodash process --caseroot YOURCASEROOT --all","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"v0lP1qXJTu"},{"type":"text","value":" (or name just the pieces you changed, e.g. ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"BIkkMxtLog"},{"type":"inlineCode","value":"--bc","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Bo0gtt4NBr"},{"type":"text","value":", ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Ge7ka9DSd7"},{"type":"inlineCode","value":"--cice","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"LadzqWkx9l"},{"type":"text","value":"; see ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"oSryYslNh9"},{"type":"inlineCode","value":"crocodash process -h","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"u69EJOZ69d"},{"type":"text","value":")!","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"KeKHiRoDFy"}],"key":"mKauh8eoW5"}],"identifier":"cabe7467","html_id":"cabe7467","key":"SYkdOBBHV6"}],"key":"cOkevN8a11"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Project: Ocean Only Configuration - The Bare Minimum","url":"/crocodash/projects/ocean-only","group":"Use Cases"},"next":{"title":"Project: WW3 Configuration - Ayy, It’s Wave!","url":"/crocodash/projects/ww3","group":"Use Cases"}}},"domain":"http://localhos