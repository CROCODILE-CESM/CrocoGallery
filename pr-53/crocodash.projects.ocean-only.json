},"children":[{"type":"text","value":"We’ll pick a 100x100 point horizontal grid and a standard vertical grid.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"gjXLLEbpf8"}],"key":"Vuz8MBMi2F"}],"key":"aKFWRUS8zW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\n\ngrid = Grid(\n  resolution = 0.05, # in degrees\n  xstart = 278.0, # min longitude in [0, 360]\n  lenx = 5.0, # longitude extent in degrees\n  ystart = 7.0, # min latitude in [-90, 90]\n  leny = 5.0, # latitude extent in degrees\n  name = \"basic_grid\",\n)\n\n\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = 2000,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)","key":"a181JztxyI"},{"type":"outputs","id":"Os9mp_rilnMOboILFAba7","children":[],"key":"OMpsQqZECp"}],"key":"VyseLpYG3q"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now that we have our horizontal and vertical grids, we need to setup our bathymetry. Normally, we’d use the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pMMzRB2EFq"},{"type":"inlineCode","value":"Topo.set_from_dataset","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kGuGeErQo5"},{"type":"text","value":" function to go from a bathymetry dataset to grid bathymetry. However, as a first step we’ll skip the dataset entirely and use an idealized bathymetry. ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"V4OK1OO2UD"},{"type":"inlineCode","value":"Topo","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nQ6X96uY9X"},{"type":"text","value":" provides helpers mirroring MOM6’s built-in TOPO_CONFIG options, such as ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mNEw6lu7Le"},{"type":"inlineCode","value":"spoon","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"aUz15nVhIJ"},{"type":"text","value":", the analytic basin shape used in MOM6’s idealized double gyre case.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vGJPl1f9Uu"}],"key":"gWIZe6QXun"}],"key":"gHSPLY1COT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.topo import Topo\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_spoon(max_depth = 2000, dedge = 200)\n\ntopo.depth.plot()","key":"ZfFMjlKqph"},{"type":"outputs","id":"nKWxNcOgEiCkiJagJ4-Vh","children":[],"key":"oMXYi3dFgA"}],"key":"l2fTJSLAyM"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Great! So I’m going to create my case now, and this step will hardly ever change!","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ArzhWzAK7k"}],"key":"hNTbKC28mN"}],"key":"fQh07pCKFE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nfrom CrocoDash.case import Case\n\n# CESM case (experiment) name\ncasename = \"basic_ocean\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = \"ncgd0011\", # Update this with your project code\n    override = True,\n    machine = \"derecho\",\n    compset = \"CR_JRA\"\n)","key":"WQuQtaz2kq"},{"type":"outputs","id":"nUhVq8kOCYqOR_J91XLyr","children":[],"key":"VtsCehLOpy"}],"key":"YW26fqaHje"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now, the last step is to generate forcings, which is done as a two step configure and process. Since it can take a long time to get raw data from outside sources, we’re going to use a fake data generator that comes with CrocoDash.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"aR3a5imQtH"}],"key":"nGOXJTAneD"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"I also think we can run for 60 days. That doesn’t sound too bad.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vrHvIDJPPE"}],"key":"KzLg0pY1KN"}],"key":"lX8pLIqzlz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range = [\"2019-01-01 00:00:00\", \"2019-03-03 00:00:00\"],\n    product_name=\"reference_ocean\",\n    function_name=\"get_reference_ocean_data\"\n)\n","key":"dPvUQuU3tw"},{"type":"outputs","id":"RBXezTtHMqae8J8FqftQQ","children":[],"key":"dTtrTyO6jg"}],"key":"knddelSl9v"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.process_forcings()\n","key":"JiBN6EXOIM"},{"type":"outputs","id":"syJ8b5GWLCG7fBf5FIg6z","children":[],"key":"ScKJmvcRB6"}],"key":"XQuWEScBBS"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Cool! Once this is done, we have to ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"AuUCbLYHex"},{"type":"inlineCode","value":