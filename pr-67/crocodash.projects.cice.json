raph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Given how lat/lon changes a lot towards the poles, we’ll use a projected grid. The only nuance is in the forcing, so we’ll rip through the first few steps first.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"XlZQLgWUB7"}],"key":"s9qmAtczEb"}],"identifier":"a8aa8f5b","html_id":"a8aa8f5b","key":"pcaZeD5uSc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\n\nfrom CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\nfrom CrocoDash.topo import Topo\nfrom CrocoDash.case import Case\n\n\ngrid = Grid.from_projection(\n    crs=\"EPSG:3995\",\n    x_min=-1_000_000,  # meters from pole\n    x_max= 1_000_000,\n    y_min=-1_000_000,\n    y_max= 1_000_000,\n    resolution_m=50_000,  # 50 km\n    name=\"arctic_50km\",\n)\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_from_dataset(    \n    bathymetry_path = \"<GEBCO_LOWRES>\",\n    longitude_coordinate_name=\"lon\",\n    latitude_coordinate_name=\"lat\",\n    vertical_coordinate_name=\"elevation\"\n)\n\ntopo.depth.plot()\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = topo.max_depth,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)\n","key":"C1D5J2TQaY"},{"type":"outputs","id":"RFA0EDYHvx9pse_Z6N4T8","children":[],"key":"w3PoxltVfo"}],"identifier":"5836c56d","html_id":"5836c56d","key":"wOMJgFQtwT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# CESM case (experiment) name\ncasename = \"arctic_50km\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = '<PROJECT>',\n    job_queue = \"<JOB_QUEUE>\", # PBS queue the run is submitted to\n    job_wallclock_time = \"<WALLCLOCK_1H>\", # hh:mm:ss walltime requested for the run\n    override = True,\n    machine = \"derecho\",\n    compset = \"GR_JRA\" )\n","key":"kIGlr34LFg"},{"type":"outputs","id":"sTNY22bwM5qx_hkgtXm0W","children":[],"key":"vEJk8OcZab"}],"identifier":"721566fe","html_id":"721566fe","key":"AlrWQOw5Nf"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"How do CICE OBCs work?","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BvSuwQRvNM"}],"identifier":"how-do-cice-obcs-work","label":"How do CICE OBCs work?","html_id":"how-do-cice-obcs-work","implicit":true,"key":"jP7DIMdBTq"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"CICE OBCs “restore” from a grid that is exactly one additional cell in each direction. CrocoDash generates that halo grid (one T-cell on every side) and fills it from a CICE-shaped source, which CICE then restores toward. The source is a real global CICE restart (","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"NGbVTwikYM"},{"type":"inlineCode","value":"cice_restart","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"myStsJuK3M"},{"type":"text","value":"), or ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"lE4TIG4o48"},{"type":"inlineCode","value":"reference_ice","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"sDGlmI6Bul"},{"type":"text","value":", a synthetic stand-in that needs no files and is handy for checking the wiring.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"NYlOIp1XkH"}],"key":"OiGL7jbcPN"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Restoring is opt-in, and takes all three of ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"s1WCRd38Le"},{"type":"inlineCode","value":"restore_ice=True","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"OLKQg7AlIw"},{"type":"text","value":", ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"V6H4YKdUVy"},{"type":"inlineCode","value":"cice_product_name","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"hGvUBetFUx"},{"type":"text","value":" and ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"aQOpoOaQQu"},{"type":"inlineCode","value":"cice_function_name","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"Oe3nGHFK16"},{"type":"text","value":". Leave all three out and CICE runs with zero-gradient boundaries and no restoring. In the following cell, we point the ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"UvnwP98jJX"},{"type":"inlineCode","value":"cice_restart","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"Ce8miOPQq6"},{"type":"text","value":" product at exactly one restart.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"MrljHFuwMP"}],"key":"pgh3dB3oBM"}],"identifier":"91ffaa47","html_id":"91ffaa47","key":"dO8W3M074C"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range=[\"2020-01-01 00:00:00\", \"2020-01-09 00:00:00\"],\n    function_name=\"get_glorys_data_from_rda\",\n    restore_ice=True,                             # turn on CICE boundary restoring\n