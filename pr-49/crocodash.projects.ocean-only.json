{"version":3,"kind":"Notebook","sha256":"1d5c66543862d8a9a078d9f2fe87b73b731f3c76b2f4f60f1d8e4cc516385a66","slug":"crocodash.projects.ocean-only","location":"/crocodash/projects/ocean_only.ipynb","dependencies":[],"frontmatter":{"title":"Project: Ocean Only Configuration - The Bare Minimum","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"CrocoDash","language":"python"},"github":"https://github.com/CROCODILE-CESM/CrocoGallery","numbering":{"title":{"offset":2}},"source_url":"https://github.com/CROCODILE-CESM/CrocoGallery/blob/main/crocodash/projects/ocean_only.ipynb","edit_url":"https://github.com/CROCODILE-CESM/CrocoGallery/edit/main/crocodash/projects/ocean_only.ipynb","exports":[{"format":"ipynb","filename":"ocean_only.ipynb","url":"/CrocoGallery/pr-49/build/ocean_only-d7a761a88db0560af2c3d90758e253b3.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This project is all about how we create the most basic ocean_only domain to shake things out, get spinning as fast as possible. Test everything before we get into our research question.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xAnL0aUS3j"}],"key":"ZqJPPkUQfd"}],"key":"o9b03lfgxQ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Download this project by either:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"o1PtHZiTWB"}],"key":"dRiH9hTVxt"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Running the CrocoDash CLI command: ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Mj904f5mq0"},{"type":"inlineCode","value":"crocodash template --machine derecho --notebook crocodash.projects.ocean_only","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"cK3c7K6txx"}],"key":"rXra0RQX5g"}],"key":"VGB3JkTIRf"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Copying the file from your CrocoDash checkout: ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"y0wq0spEz8"},{"type":"inlineCode","value":"demos/crocodash/projects/ocean_only","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"WZhPNX3tsG"}],"key":"bbNABzrGFA"}],"key":"klyvVD9T8k"}],"key":"kxow6ltpnp"}],"key":"mE8ldjT1zK"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Grid Generation - The first thing we are going to do is think about how to get a fast domain going, so I might look at some scaling data we’ve put online: ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Bi4D9Eihu1"},{"type":"link","url":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"https://​crocodile​-cesm​.github​.io​/SeaSloth​/mom6​_scaling​.html","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mgd0qYbo02"}],"urlSource":"https://crocodile-cesm.github.io/SeaSloth/mom6_scaling.html","key":"MmbnKWjhWM"}],"key":"ZVaeqKLOMe"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Given how fast a 100x100 domain is, I think we should go with that, with maybe 40 cores for the Ocean. That’ll run wicked fast.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"eiIt27qI7W"}],"key":"dw4ycpy9dW"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"We’ll pick an arbitrary vertical grid.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"LBnNmPBM2j"}],"key":"XY0NsrzXrD"}],"key":"FTMFrAz4HX"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\n\ngrid = Grid(\n  resolution = 0.05, # in degrees\n  xstart = 278.0, # min longitude in [0, 360]\n  lenx = 5.0, # longitude extent in degrees\n  ystart = 7.0, # min latitude in [-90, 90]\n  leny = 5.0, # latitude extent in degrees\n  name = \"basic_grid\",\n)\n\n\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = 2000,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)","key":"hI4GO7f68c"},{"type":"outputs","id":"avl5pi50_3mqY73L4fptE","children":[],"key":"syeOqToeQ6"}],"key":"jAIMHd5IT9"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now that we have our grids, we need to setup a bathymetry object. Normally, we’d use the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Ukh64ncKq3"},{"type":"inlineCode","value":"Topo.set_from_dataset","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"z1J6WpKX7D"},{"type":"text","value":" function to go from “obs” to a bathymetry on our grid. But we’re trying to move with purpose, so we can use some Topo functions to create our own fun little domain.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"e2CRkhkMpn"}],"key":"Yt8j7YrY5z"}],"key":"LqyR9lcTVc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from CrocoDash.topo import Topo\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_bowl(max_depth = 2000, dedge = 200)\n\ntopo.depth.plot()","key":"JKBSaqxd4Z"},{"type":"outputs","id":"Ixs4iK7pxLOGsCVDM076G","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"192108fb1cf861f2d6ed17b6fbbdc581","path":"/CrocoGallery/pr-49/build/192108fb1cf861f2d6ed17b6fbbdc581.png"},"text/plain":{"content":"<Figure size 640x480 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"k6oQKIWuW3"}],"key":"gx9LivRE7u"}],"key":"lnR121VIUl"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Great! So I’m going to create my case now, and this step will hardly every change","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eZyu647BEY"}],"key":"nXjAw98mHK"}],"key":"YWLUbJLEEv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nfrom CrocoDash.case import Case\n\n# CESM case (experiment) name\ncasename = \"basic_ocean\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = \"<inputdir>\"\n    \n# CESM case directory\ncaseroot = \"<casedir>\"\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = 'CESM0030',\n    override = True,\n    machine = \"derecho\",\n    compset = \"CR_JRA\"\n)","key":"bvMzaSDJq4"},{"type":"outputs","id":"K4IlvURgPJucE3lRaPJDd","children":[],"key":"emNSCis1Fl"}],"key":"yUsW7wrstB"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now, the last step is to generate forcings. Which we do with a configure and process step. It always takes a long time to get raw data from other places, so we’re going to use a fake data product. I also think we can run for 60 days. Doesn’t sound too bad.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hiVMlxq0Ra"}],"key":"m24lXLSogk"}],"key":"oUkULZKwg1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range = [\"2019-01-01 00:00:00\", \"2019-03-03 00:00:00\"],\n    product_name=\"reference_ocean\",\n    function_name=\"get_reference_ocean_data\"\n)\ncase.process_forcings()","key":"ikkOYMN9SH"},{"type":"outputs","id":"krLGgQQLCxA7EwG5mhYrU","children":[],"key":"cBkHV9nahg"}],"key":"FI3DOM8MMB"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Cool! Once this is done we have to ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VZ92HPO2ni"},{"type":"inlineCode","value":"case.build","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Zk3fL1sccW"},{"type":"text","value":" and ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"djqpRVF1MA"},{"type":"inlineCode","value":"case.submit","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"uahiWmuFRV"},{"type":"text","value":" in our case directory. Before that though, here’s some things I’d ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yrA0OpXHQs"},{"type":"inlineCode","value":"xmlchange","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CuX52j6eEd"},{"type":"text","value":" to run faster.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pU4FEMPiHx"}],"key":"DWOfeBEGPV"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the NTASKS=10, which sets every component to 10 cores, and makes the data atmosphere regridding very fast. (All components share these 10 cores)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"cLLbcUjsTs"}],"key":"TH2PVF2oAk"}],"key":"DTGvKZueYD"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the NTASKS_OCN=40 because of the scaling data we saw.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"yCZ8qSkgoC"}],"key":"OoUo6ShCp6"}],"key":"pRTg2oKfgx"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ROOTPE=0, which ensures that all components share the same cores. If I set ROOTPE_OCN=10, it would skip the first 10 cores and run on the next 40 cores.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"W0JV2VKCwg"}],"key":"eZqKjeYFOd"}],"key":"JiQMEYYS6t"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the JOB_WALLCLOCK_TIME=00:30:00 --subgroup ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"ihek9vuC7b"}