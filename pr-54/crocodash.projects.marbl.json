osition":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jmSPPCJXv9"},{"type":"inlineCode","value":"crocodash template --output marbl_case.ipynb --machine glade --notebook crocodash.projects.marbl","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"V99KjrnTEp"},{"type":"text","value":", then filling in ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"f367IvC7aS"},{"type":"inlineCode","value":"<CESM>","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XnFWQxDZt1"},{"type":"text","value":", ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"yyT8kEb9dU"},{"type":"inlineCode","value":"<inputdir>","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"leEhhBOQPn"},{"type":"text","value":" and ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fewMGgiMjy"},{"type":"inlineCode","value":"<casedir>","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"L4eT2AWBL7"}],"key":"dP8BbZH7Jd"}],"key":"azrzSwblb2"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Copying the file from your CrocoDash checkout: ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"o8LjT1LLn4"},{"type":"inlineCode","value":"gallery/crocodash/projects/marbl.ipynb","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"boikJaq3jW"}],"key":"QmUEmp3M08"}],"key":"n9G6wB80Zk"}],"key":"rzluMk5mBs"}],"identifier":"f5cea3da","html_id":"f5cea3da","key":"cETNNyHyzX"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Grid Generation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yrFWZcWuJS"}],"identifier":"grid-generation","label":"Grid Generation","html_id":"grid-generation","implicit":true,"key":"sxFlyKonPa"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"MARBL is integrated into MOM6, so it’s pretty straightforward to set up. Since there are so many tracers, MARBL’s initial and boundary conditions come from a previous CESM run, which carries all of them.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"FpsyRTa1Ib"}],"key":"uGOdNLGoGU"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Since MARBL adds cost, we will pick a small domain. Let’s rip through the first steps!","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"cxhsOagqPq"}],"key":"EAqJWp47pd"}],"identifier":"4159d43f","html_id":"4159d43f","key":"d4xc6vXpUe"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\n\nfrom CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\nfrom CrocoDash.topo import Topo\nfrom CrocoDash.case import Case\n\n\ngrid = Grid(\n  resolution = 0.05, # in degrees\n  xstart = 278.0, # min longitude in [0, 360]\n  lenx = 5.0, # longitude extent in degrees\n  ystart = 7.0, # min latitude in [-90, 90]\n  leny = 5.0, # latitude extent in degrees\n  name = \"clear_marbl\",\n)\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_from_dataset(    \n    bathymetry_path = \"<GEBCO_LOWRES>\",\n    longitude_coordinate_name=\"lon\",\n    latitude_coordinate_name=\"lat\",\n    vertical_coordinate_name=\"elevation\"\n)\n\ntopo.depth.plot()\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = topo.max_depth,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)\n","key":"ILTrINCzYt"},{"type":"outputs","id":"7ROhtgVpksrr_nXdA07GB","children":[],"key":"FqmW38qfvh"}],"identifier":"97f7d835","html_id":"97f7d835","key":"AS3c8q5tda"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# CESM case (experiment) name\ncasename = \"lost_my_marbles\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = '<PROJECT>',\n    job_queue = \"<JOB_QUEUE>\", # PBS queue the run is submitted to\n    job_wallclock_time = \"<WALLCLOCK_1H>\", # hh:mm:ss walltime requested for the run\n    override = True,\n    machine = \"derecho\",\n    compset = \"CR1850MARBL_JRA\" )\n","key":"Mx0mcfVam0"},{"type":"outputs","id":"Pw66mXo_QcHYTNA5Qs6F5","children":[],"key":"g5pEIRXjDW"}],"identifier":"9594fa12","html_id":"9594fa12","key":"sPZHk1wdCI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"MARBL Forcing","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZemkmwlvF9"}],"identifier":"marbl-forcing","label":"MARBL Forcing","html_id":"marbl-forcing","implicit":true,"key":"FgKgWoPstR"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We use a global MARBL file to set up the initial condition (It is regridded as part of the model run). We generate MARBL OBCs in the same exact way as the MOM6 OBC (we’re just adding >40 more tracers).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"RJPSC8yvSx"}],"key":"Bh1SYcJ5Mg"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"We need to provide the path to a MARBL run or have it default to a run to generate MARBL OBCs. What we’re going to use below defaults to a FIESTY run (","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"lEogNSfayq"},{"type":"link","url":"https://www.sciencedirect.com/science/article/abs/pii/S0079661124001204","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"https://​www​.sciencedirect​.com​/science​/article​/abs​/pii​/S0079661124001204","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"v2p0s1MmMA"}],"urlSource":"https://www.sciencedirect.com/science/article/abs/pii/S0079661124001204","key":"UDUvze6Qha"},{"type":"text","value":"). We do not support having separate physical vs MARBL forcings. All the forcings come from one product, which in this case is CESM POP Output, the old CESM ocean model.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"nOggC8U1WI"}],"key":"CwaCqLt98c"}],"identifier":"c89e4efb","html_id":"c89e4efb","key":"fzaNV1b9Fl"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range=[\"2000-01-01 00:00:00\", \"2000-02-01 00:00:00\"],\n    product_name=\"CESM_POP_OUTPUT\",\n    function_name=\"get_cesm_single_variable_data\",\n    marbl_ic_filepath=\"<MARBL_IC>\",   \n)\n","key":"Lf69nP858H"},{"type":"outputs","id":"pHOm37CYRjtsNJ99X9g-N","children":[],"key":"AbSiCYpPSR"}],"identifier":"ade13bab","html_id":"ade13bab","key":"q2lDaulFeI"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.process_forcings()\n","key":"vcW3QJ32he"},{"type":"outputs","id":"9EJrwYAvDTJ0FKQX_cSBM","children":[],"key":"aQKyFojFsL"}],"identifier":"f9afd784","html_id":"f9afd784","key":"zjgzSZUTGX"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"I’d mess with the NTASKS/ROOTPEs (give more ocean PEs) and build & submit!","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Tm55FId8n7"}],"key":"tqXZAe71be"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Feel free to iterate with process forcings! You can run it on the command line with ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"bwgmtk9Hnd"},{"type":"inlineCode","value":"crocodash process --caseroot YOURCASEROOT --all","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"MlVCw0IMq6"},{"type":"text","value":" (or name just the pieces you changed, e.g. ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"az7c2gb335"},{"type":"inlineCode","value":"--bc","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"u0ISU0w8AE"},{"type":"text","value":", ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"sP8JTCWLLD"},{"type":"inlineCode","value":"--cice","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"H8EHdZFNNY"},{"type":"text","value":"; see ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ZHkyOcyOqA"},{"type":"inlineCode","value":"crocodash process -h","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jvJSjAKeQs"},{"type":"text","value":")!","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Sn97lDQbnn"}],"key":"lyUGUgZiUV"}],"identifier":"b8b1563c","html_id":"b8b1563c","key":"trGeiD4mGl"}],"key":"IuHtVLmtIm"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"titl