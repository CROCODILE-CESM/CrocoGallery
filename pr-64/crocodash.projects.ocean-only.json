:", which ensures that all components share the same cores. If I set ROOTPE_OCN=10, it would skip the first 10 cores and run on the next 40 cores.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"YlxngGzk3J"}],"key":"E2hCU0Z7lf"}],"key":"VOIxHXXkCT"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I’d set the ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"cu8hUdIluQ"},{"type":"inlineCode","value":"JOB_WALLCLOCK_TIME = 00:30:00 --subgroup case.run","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"uPrxva0C9F"},{"type":"text","value":", which ensures the queue picks up our job realllly fast.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"XuvBHUhIK5"}],"key":"xvE6ckFIVf"}],"key":"fC0awT1uUb"}],"key":"fuyHsodnI0"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"And there we go! A fake running ocean model! Isn’t that awesome!","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"MnT71AyUXb"}],"key":"DhX2rjjMuP"}],"identifier":"6fa10400","html_id":"6fa10400","key":"bhsQ5MG9ln"}],"key":"PszSVjO31w"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"CrocoDash Projects","short_title":"Projects","url":"/crocodash/projects","group":"Use Cases"},"next":{"title":"Project: CICE Configuration - Ayy, It’s Chilly!","url":"/crocodash/projects/cice","group":"Use Cases"}}},"domain":"http://localhost:3000"}