":[{"type":"text","value":"For WW3, we need to think a bit about how expensive it’s going to be (and the answer is fairly high). Please talk to Alper Altuntas for more information. We can run WW3 with no OBCs, but for the sake of explaining everything, we are going to use OBCs.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"MP3CS3Q49S"}],"key":"CAMy1zXYOj"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Given this criteria, I’m going to rip through the first few steps.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"VSvWHH50j9"}],"key":"RSE4fWvlNE"}],"identifier":"ccdd29a5","html_id":"ccdd29a5","key":"IrFRcbV90i"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\n\nfrom CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\nfrom CrocoDash.topo import Topo\nfrom CrocoDash.case import Case\n\n\ngrid = Grid(\n  resolution = 0.05, # in degrees\n  xstart = 278.0, # min longitude in [0, 360]\n  lenx = 5.0, # longitude extent in degrees\n  ystart = 7.0, # min latitude in [-90, 90]\n  leny = 5.0, # latitude extent in degrees\n  name = \"wave_fun_grid\",\n)\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_from_dataset(    \n    bathymetry_path = \"<GEBCO_LOWRES>\",\n    longitude_coordinate_name=\"lon\",\n    latitude_coordinate_name=\"lat\",\n    vertical_coordinate_name=\"elevation\"\n)\n\ntopo.depth.plot()\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = topo.max_depth,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)\n","key":"zsG9W2MJSR"},{"type":"outputs","id":"sz1zOhqpJyDXzrMeDqjIg","children":[],"key":"KSQUpfocrs"}],"identifier":"7c344d57","html_id":"7c344d57","key":"vRsyGQthyP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# CESM case (experiment) name\ncasename = \"wave_fun_zone\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = '<PROJECT>',\n    job_queue = \"<JOB_QUEUE>\", # PBS queue the run is submitted to\n    job_wallclock_time = \"<WALLCLOCK_1H>\", # hh:mm:ss walltime requested for the run\n    override = True,\n    machine = \"derecho\",\n    compset = \"1850_DATM%NYF_SLND_SICE_MOM6%REGIONAL_SROF_SGLC_WW3\",\n    atm_grid_name = \"T62\" )\n","key":"U9N3RtwMQn"},{"type":"outputs","id":"DFhNi9T8M88UrOWtZLbA4","children":[],"key":"HHWmn4lg55"}],"identifier":"d41c9d07","html_id":"d41c9d07","key":"bjbvpQ61IT"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"WW3 Forcing","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"T6ivo5ICwk"}],"identifier":"ww3-forcing","label":"WW3 Forcing","html_id":"ww3-forcing","implicit":true,"key":"rtxBsfBsbv"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"WW3 OBC Forcing gets set up in a unique way. WW3 comes with a Fortran script to take “station-like” OBCs and regrids them onto the boundaries of your domain. All we do is prep “station-like” data. In CrocoDash, we take a slice of whatever data product we have (which in our case is ERA5 2D Wave Spectra), and do the following steps:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"LUi9dZPuAC"}],"key":"ILnLIpULfQ"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":5,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Split the grid points into single point station files (netcdf)","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"rjdfmqpSM0"}],"key":"By5AiHCY1p"}],"key":"ePgeeYwSPS"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Create a file to list them (spec.list)","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"JjBgUjTQSw"}],"key":"ZmxZjSkLZy"}],"key":"j76u5dMeki"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Set a few configuration parameters in a different file (bounc.nml)","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"nVx6DUiGG1"}],"key":"ER9Tyr01so"}],"key":"Jz26Q0azsN"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Place all of these files in the input directory for waves (the directory is defined as a CESM xml variable).","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"QXtBJBIIkZ"}],"key":"iaUAoEv1fb"}],"key":"snH2xdE4NM"}],"key":"jT3gz1K5G6"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"When you run ","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"cH85UwNkYi"},{"type":"inlineCode","value":"./preview_namelist","position":{"start":{"line":10,"column":1},"end":{"line":10,"column"