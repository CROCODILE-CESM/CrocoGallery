ph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Given how lat/lon changes a lot towards the poles, we’ll use a projected grid. The only nuance is in the forcing, so we’ll rip through the first few steps first.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"zaJ7yqdRkn"}],"key":"RGuY8aezco"}],"identifier":"a8aa8f5b","html_id":"a8aa8f5b","key":"GUktqPbKeA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\n\nfrom CrocoDash.grid import Grid\nfrom CrocoDash.vgrid import VGrid\nfrom CrocoDash.topo import Topo\nfrom CrocoDash.case import Case\n\n\ngrid = Grid.from_projection(\n    crs=\"EPSG:3995\",\n    x_min=-1_000_000,  # meters from pole\n    x_max= 1_000_000,\n    y_min=-1_000_000,\n    y_max= 1_000_000,\n    resolution_m=50_000,  # 50 km\n    name=\"arctic_50km\",\n)\n\ntopo = Topo(\n    grid = grid,\n    min_depth = 9.5, # in meters\n)\n\ntopo.set_from_dataset(    \n    bathymetry_path = \"<GEBCO_LOWRES>\",\n    longitude_coordinate_name=\"lon\",\n    latitude_coordinate_name=\"lat\",\n    vertical_coordinate_name=\"elevation\"\n)\n\ntopo.depth.plot()\nvgrid  = VGrid.hyperbolic(\n    nk = 75, # number of vertical levels\n    depth = topo.max_depth,\n    ratio=20.0 # target ratio of top to bottom layer thicknesses\n)\n","key":"xMXoXAnA7n"},{"type":"outputs","id":"gx-nqiZx7UBI-RTaX6-W6","children":[],"key":"XL3YHIcyHJ"}],"identifier":"5836c56d","html_id":"5836c56d","key":"fwMLbsNnqT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# CESM case (experiment) name\ncasename = \"arctic_50km\"\n\n# CESM source root (Update this path accordingly!!!)\ncesmroot =\"<CESM>\"\n\n# Place where all your input files go \ninputdir = Path(\"<inputdir>\") / casename\n    \n# CESM case directory\ncaseroot = Path(\"<casedir>\") / casename\n\n\ncase = Case(\n    cesmroot = cesmroot,\n    caseroot = caseroot,\n    inputdir = inputdir,\n    ocn_grid = grid,\n    ocn_vgrid = vgrid,\n    ocn_topo = topo,\n    project = '<PROJECT>',\n    job_queue = \"<JOB_QUEUE>\", # PBS queue the run is submitted to\n    job_wallclock_time = \"<WALLCLOCK_1H>\", # hh:mm:ss walltime requested for the run\n    override = True,\n    machine = \"derecho\",\n    compset = \"GR_JRA\" )\n","key":"Ppf9EfFnHK"},{"type":"outputs","id":"taAIB1UOIGWbgDk_YGNcp","children":[],"key":"bDY5jeDeMT"}],"identifier":"721566fe","html_id":"721566fe","key":"K4UUCUuYcl"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"How do CICE OBCs work?","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Cnv28nKObb"}],"identifier":"how-do-cice-obcs-work","label":"How do CICE OBCs work?","html_id":"how-do-cice-obcs-work","implicit":true,"key":"iKfVRNnKRn"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"CICE OBCs “restore” from a grid that is exactly one additional cell in each direction. CrocoDash generates that halo grid (one T-cell on every side) and fills it from a CICE-shaped source, which CICE then restores toward. The source is a real global CICE restart (","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"Z7TDSpPdrn"},{"type":"inlineCode","value":"cice_restart","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"HowYNoiZ2W"},{"type":"text","value":"), or ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"lcpkCuVnqz"},{"type":"inlineCode","value":"reference_ice","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"pm47fsLche"},{"type":"text","value":", a synthetic stand-in that needs no files and is handy for checking the wiring.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"nNmCS63vnk"}],"key":"Ugh5EAnksc"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Restoring is opt-in, and takes all three of ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"XMBnW8vSfk"},{"type":"inlineCode","value":"restore_ice=True","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"Azi7PN1m0x"},{"type":"text","value":", ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"fI2ZL95QXL"},{"type":"inlineCode","value":"cice_product_name","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"Qm737db9Ua"},{"type":"text","value":" and ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"iLp39WhaDp"},{"type":"inlineCode","value":"cice_function_name","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"Do7AjyEPg5"},{"type":"text","value":". Leave all three out and CICE runs with zero-gradient boundaries and no restoring. In the following cell, we point the ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"zhp9gAPKAw"},{"type":"inlineCode","value":"cice_restart","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"pZ7lLrK5Y1"},{"type":"text","value":" product at exactly one restart.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"bsNIHsMhSA"}],"key":"nsbxomuQjN"}],"identifier":"91ffaa47","html_id":"91ffaa47","key":"Yz8HTqJEEA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.configure_forcings(\n    date_range=[\"2020-01-01 00:00:00\", \"2020-01-09 00:00:00\"],\n    function_name=\"get_glorys_data_from_rda\",\n    restore_ice=True,                             # turn on CICE boundary restoring\n    cice_product_name=\"cice_restart\",\n    cice_function_name=\"get_cice_restart_subset\",\n    cice_function_args={\n        \"restart_path\": \"<CICE_RESTART>\",\n        \"grid_path\": \"<TX2_3V3_GRID>\",  # the restart's companion grid file\n    },\n)\n","key":"TPpqBg4L7I"},{"type":"outputs","id":"e7BhS_pBl2R_DVRBkbE6d","children":[],"key":"SN1nMg2jhF"}],"identifier":"7ce8b5e0","html_id":"7ce8b5e0","key":"aWQoIdOiZf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"case.process_forcings()\n","key":"bpCHw4TCr8"},{"type":"outputs","id":"va-XIwk3kbnHnMWwfKZ0N","children":[],"key":"yab4WfTdDy"}],"identifier":"a8292319","html_id":"a8292319","key":"sszO9BNoby"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This restoring we are setting up here is only for boundary conditions. If you want to start from an initial condition, check out the docs here: ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"w2T8fkKMn0"},{"type":"link","url":"https://crocodile-cesm.github.io/CrocoGallery/latest/crocodash/case-setup/#optional-warm-start-from-cice-restart-files","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"https://​crocodile​-cesm​.github​.io​/CrocoGallery​/latest​/crocodash​/case​-setup​/​#optional​-warm​-start​-from​-cice​-restart​-files","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ePLghiTv1l"}],"urlSource":"https://crocodile-cesm.github.io/CrocoGallery/latest/crocodash/case-setup/#optional-warm-start-from-cice-restart-files","key":"iiTBu5eTcA"}],"key":"tPb4hv8wHr"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"I’d then mess with the NTASKS/ROOTPE layout to make sure everything looks reasonable, then build & submit.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"D2JvOPycCk"}],"key":"zH6jhUKWdI"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Feel free to iterate with process forcings! You can run it on the command line with ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"qg9JHqNtW1"},{"type":"inlineCode","value":"crocodash process --caseroot YOURCASEROOT --all","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"PjpP8HSVGG"},{"type":"text","value":" (or name just the pieces you changed, e.g. ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"G4XBRiEbeX"},{"type":"inlineCode","value":"--bc","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"v6UBeNIMYG"},{"type":"text","value":", ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"wburpTpHgk"},{"type":"inlineCode","value":"--cice","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"l8JlqZh683"},{"type":"text","value":"; see ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"blLgt1ATm3"},{"type":"inlineCode","value":"crocodash process -h","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"f2bHJSJhni"},{"type":"text","value":")!","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"yxA8zXcFPF"}],"key":"EH73ZkSBAq"}],"identifier":"cabe7467","html_id":"cabe7467","key":"PhbbAsVNpD"}],"key":"b2axwhYcoc"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Project: Ocean Only Configuration - The Bare Minimum","url":"/crocodash/projects/ocean-only","group":"Use Cases"},"next":{"title":"Project: WW3 Configuration - Ayy, It’s Wave!","url":"/crocodash/projects/ww3","group":"Use Cases"}}},"domain":"http://localhost:3000"}